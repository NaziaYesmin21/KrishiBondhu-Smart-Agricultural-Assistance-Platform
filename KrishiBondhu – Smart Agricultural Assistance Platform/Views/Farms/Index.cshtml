@model IEnumerable<Farm>

@{
    ViewData["Title"] = "Farms";
}

<style>

    .farms-page {
        padding: 35px 0 60px;
    }

    .farms-container {
        max-width: 1280px;
        margin: auto;
        padding: 0 22px;
    }

    /* HEADER */

    .farms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .farms-title-area h1 {
        margin: 0;
        color: #173d2b;
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -0.6px;
    }

    .farms-title-area p {
        margin: 7px 0 0;
        color: #78857e;
        font-size: 12px;
    }

    .farms-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 17px;
        background: #176b45;
        color: white;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        box-shadow: 0 7px 16px rgba(23, 107, 69, 0.16);
        transition: 0.2s;
    }

    .farms-add-btn:hover {
        color: white;
        background: #125a3a;
        transform: translateY(-2px);
    }


    /* SUMMARY */

    .farms-summary {
        display: flex;
        align-items: center;
        gap: 13px;
        background: #e4f1e8;
        border: 1px solid #d2e5d8;
        border-radius: 14px;
        padding: 14px 17px;
        margin-bottom: 18px;
    }

    .farms-summary-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #cfe5d5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .farms-summary-number {
        color: #173d2b;
        font-size: 18px;
        font-weight: 750;
    }

    .farms-summary-text {
        color: #748179;
        font-size: 10px;
        margin-top: 2px;
    }


    /* TABLE CARD */

    .farms-card {
        background: rgba(255,255,255,0.94);
        border: 1px solid #dfe9e2;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(31, 77, 52, 0.055);
    }

    .farms-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 19px 22px;
        border-bottom: 1px solid #e7eee9;
    }

    .farms-card-title {
        margin: 0;
        color: #244536;
        font-size: 14px;
        font-weight: 700;
    }

    .farms-card-subtitle {
        margin: 3px 0 0;
        color: #87928c;
        font-size: 10px;
    }


    /* TABLE */

    .farms-table-wrapper {
        overflow-x: auto;
    }

    .farms-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 780px;
    }

    .farms-table thead {
        background: #f4f8f5;
    }

    .farms-table th {
        padding: 13px 17px;
        text-align: left;
        color: #65746b;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        border-bottom: 1px solid #e3ebe5;
    }

    .farms-table td {
        padding: 15px 17px;
        color: #53635a;
        font-size: 11px;
        border-bottom: 1px solid #edf2ee;
        vertical-align: middle;
    }

    .farms-table tbody tr {
        transition: 0.18s;
    }

    .farms-table tbody tr:hover {
        background: #f8fbf9;
    }

    .farms-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* FARM NAME */

    .farm-name {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .farm-icon {
        width: 35px;
        height: 35px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e7f3eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .farm-name-text {
        color: #254638;
        font-size: 12px;
        font-weight: 700;
    }


    /* FARMER */

    .farmer-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        background: #eef6f0;
        border-radius: 20px;
        color: #35664c;
        font-size: 10px;
        font-weight: 650;
    }


    /* AREA */

    .area-value {
        color: #28503b;
        font-weight: 700;
    }


    /* ACTIONS */

    .farm-actions {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-wrap: wrap;
    }

    .farm-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 10px;
        font-weight: 650;
        transition: 0.18s;
    }

    .farm-edit {
        background: #e8f4ed;
        color: #176b45;
    }

    .farm-edit:hover {
        background: #d8ebdf;
        color: #125a3a;
    }

    .farm-details {
        background: #eef1f0;
        color: #53635a;
    }

    .farm-details:hover {
        background: #e1e6e3;
        color: #34463c;
    }

    .farm-delete {
        background: #f9eaea;
        color: #b24b4b;
    }

    .farm-delete:hover {
        background: #f3dddd;
        color: #963939;
    }


    /* EMPTY STATE */

    .farms-empty {
        text-align: center;
        padding: 60px 20px;
    }

    .farms-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 14px;
        border-radius: 16px;
        background: #e8f3eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .farms-empty h3 {
        margin: 0;
        color: #2b493a;
        font-size: 16px;
        font-weight: 700;
    }

    .farms-empty p {
        margin: 7px 0 17px;
        color: #7d8982;
        font-size: 11px;
    }


    /* RESPONSIVE */

    @@media (max-width: 700px) {

        .farms-page {
            padding-top: 24px;
        }

        .farms-container {
            padding: 0 14px;
        }

        .farms-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .farms-title-area h1 {
            font-size: 26px;
        }

        .farms-add-btn {
            width: 100%;
            justify-content: center;
        }

    }

</style>


<div class="farms-page">

    <div class="farms-container">


        <!-- PAGE HEADER -->

        <div class="farms-header">

            <div class="farms-title-area">

                <h1>
                    Farm Directory
                </h1>

                <p>
                    Manage registered farms and their agricultural information.
                </p>

            </div>


            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-action="Create"
                   class="farms-add-btn">

                    ＋ Add New Farm

                </a>
            }

        </div>


        <!-- SUMMARY -->

        <div class="farms-summary">

            <div class="farms-summary-icon">
                🚜
            </div>

            <div>

                <div class="farms-summary-number">
                    @Model.Count()
                </div>

                <div class="farms-summary-text">
                    Registered Farms
                </div>

            </div>

        </div>


        <!-- FARM TABLE -->

        <div class="farms-card">


            <div class="farms-card-header">

                <div>

                    <h2 class="farms-card-title">
                        Farm Records
                    </h2>

                    <p class="farms-card-subtitle">
                        Connected farm and farmer information
                    </p>

                </div>

            </div>


            @if (Model.Any())
            {

                <div class="farms-table-wrapper">

                    <table class="farms-table">

                        <thead>

                            <tr>

                                <th>
                                    Farm
                                </th>

                                <th>
                                    Location
                                </th>

                                <th>
                                    Area
                                </th>

                                <th>
                                    Farmer
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {

                                <tr>

                                    <td>

                                        <div class="farm-name">

                                            <div class="farm-icon">
                                                🌾
                                            </div>

                                            <div class="farm-name-text">
                                                @item.FarmName
                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        @item.Location
                                    </td>


                                    <td>

                                        <span class="area-value">
                                            @item.Area
                                        </span>

                                    </td>


                                    <td>

                                        <span class="farmer-badge">

                                            👨‍🌾

                                            @(item.Farmer?.Name ?? "Not Assigned")

                                        </span>

                                    </td>


                                    <td>

                                        <div class="farm-actions">

                                            @if (Context.Session.GetString("Role") == "Admin")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.FarmId"
                                                   class="farm-action farm-edit">

                                                    Edit

                                                </a>
                                            }

                                            <a asp-action="Details"
                                               asp-route-id="@item.FarmId"
                                               class="farm-action farm-details">

                                                Details

                                            </a>

                                            @if (Context.Session.GetString("Role") == "Admin")
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.FarmId"
                                                   class="farm-action farm-delete">

                                                    Delete

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="farms-empty">

                    <div class="farms-empty-icon">
                        🚜
                    </div>

                    <h3>
                        No Farms Registered Yet
                    </h3>

                    <p>
                        Start by adding the first farm to KrishiBondhu.
                    </p>


                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a asp-action="Create"
                           class="farms-add-btn">

                            ＋ Add First Farm

                        </a>
                    }

                </div>

            }

        </div>

    </div>

</div>