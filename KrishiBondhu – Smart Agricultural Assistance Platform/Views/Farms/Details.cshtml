@model Farm

@{
ViewData["Title"] = "Farm Details";
}

<div class="farm-details-page">

<div class="farm-details-header">
    <div>
        <span class="farm-label">FARM MANAGEMENT</span>
        <h1>🌾 Farm Details</h1>
        <p>View complete information about this agricultural farm.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Farms
    </a>
</div>

<div class="farm-details-card">

    <div class="farm-icon">
        🌱
    </div>

    <div class="farm-info">

        <div class="info-item">
            <span class="info-label">Farm Name</span>
            <span class="info-value">@Model.FarmName</span>
        </div>

        <div class="info-item">
            <span class="info-label">Location</span>
            <span class="info-value">📍 @Model.Location</span>
        </div>

        <div class="info-item">
            <span class="info-label">Land Area</span>
            <span class="info-value">@Model.Area acres</span>
        </div>

        <div class="info-item">
            <span class="info-label">Farmer</span>
            <span class="farmer-badge">
                👨‍🌾 @(Model.Farmer?.Name ?? "Not Assigned")
            </span>
        </div>

    </div>

    <div class="farm-actions">

        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.FarmId"
               class="edit-btn">
                ✏ Edit Farm
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.FarmId"
               class="delete-btn">
                🗑 Delete Farm
            </a>
        }

        <a asp-action="Index" class="list-btn">
            🌾 Farm Directory
        </a>

    </div>

</div>

</div>

<style> .farm-details-page { max-width: 1000px; margin: 0 auto; padding: 20px 10px 50px; } .farm-details-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .farm-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .farm-details-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .farm-details-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; transition: 0.2s; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .farm-details-card { background: white; border-radius: 20px; padding: 35px; box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08); border: 1px solid #e2eee5; } .farm-icon { width: 75px; height: 75px; border-radius: 18px; background: #e9f5eb; display: flex; align-items: center; justify-content: center; font-size: 38px; margin-bottom: 28px; } .farm-info { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; } .info-item { background: #f7faf7; border: 1px solid #e5eee6; border-radius: 14px; padding: 20px; } .info-label { display: block; color: #718078; font-size: 13px; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; } .info-value { display: block; color: #183f29; font-size: 17px; font-weight: 600; } .farmer-badge { display: inline-block; background: #e4f2e7; color: #23613b; padding: 7px 12px; border-radius: 20px; font-size: 14px; font-weight: 600; } .farm-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; padding-top: 25px; border-top: 1px solid #e5eee7; } .farm-actions a { text-decoration: none; padding: 11px 18px; border-radius: 10px; font-weight: 600; transition: 0.2s; } .edit-btn { background: #e5f2e8; color: #24613c; } .edit-btn:hover { background: #d4e9d9; color: #164a2c; } .delete-btn { background: #fbe8e8; color: #a33a3a; } .delete-btn:hover { background: #f6d6d6; color: #8c2929; } .list-btn { background: #164a2c; color: white; } .list-btn:hover { background: #0f3921; color: white; } @@media (max-width: 700px) { .farm-details-header { flex-direction: column; align-items: flex-start; } .farm-details-header h1 { font-size: 27px; } .farm-details-card { padding: 24px; } .farm-info { grid-template-columns: 1fr; } .farm-actions { flex-direction: column; } .farm-actions a { text-align: center; } } </style>