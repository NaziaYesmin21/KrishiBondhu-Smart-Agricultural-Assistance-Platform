
@model IEnumerable<KrishiBondhu___Smart_Agricultural_Assistance_Platform.Models.AgroProductService>

@{
    ViewData["Title"] = "My Products & Services";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="text-success">My Products & Services</h2>
            <p class="text-muted mb-0">
                Manage your agricultural products and services.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Add New Item
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h5 class="text-success">@item.Name</h5>

                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unavailable</span>
                                }
                            </div>

                            <p>
                                <strong>Type:</strong>
                                @(item.ItemType == "Product" ? "Product" : "Service")
                            </p>

                            <p>
                                <strong>Price:</strong>
                                @item.Price.ToString("N2")
                                @if (!string.IsNullOrWhiteSpace(item.Unit))
                                {
                                    <span>/ @item.Unit</span>
                                }
                            </p>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <div class="d-flex gap-2 mt-3">
                                <a asp-action="Edit"
                                   asp-route-id="@item.AgroProductServiceId"
                                   class="btn btn-outline-success btn-sm">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.AgroProductServiceId"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this item?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No products or services added yet.</h5>
                <p class="text-muted">
                    Click the button below to add your first item.
                </p>
                <a asp-action="Create" class="btn btn-success">
                    Add Your First Item
                </a>
            </div>
        </div>
    }

    <a asp-controller="AgroFirm"
       asp-action="Dashboard"
       class="btn btn-secondary mt-4">
        Back to Dashboard
    </a>

</div>
