
@model KrishiBondhu___Smart_Agricultural_Assistance_Platform.Models.AgroProductService

@{
    ViewData["Title"] = "Edit Product or Service";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-success">Edit Product or Service</h2>
                    <p class="text-muted">
                        Update your item information.
                    </p>

                    <hr />

                    <form asp-action="Edit"
                          asp-route-id="@Model.AgroProductServiceId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input type="hidden"
                               asp-for="AgroProductServiceId" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Product / Service Name
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ItemType" class="form-label">
                                Item Type
                            </label>
                            <select asp-for="ItemType" class="form-select">
                                <option value="Product">Product</option>
                                <option value="Service">Service</option>
                            </select>
                            <span asp-validation-for="ItemType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label">
                                Price (BDT)
                            </label>
                            <input asp-for="Price"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="Price"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Unit" class="form-label">
                                Unit (Optional)
                            </label>
                            <input asp-for="Unit" class="form-control" />
                            <span asp-validation-for="Unit"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsAvailable"
                                   class="form-check-input" />
                            <label asp-for="IsAvailable"
                                   class="form-check-label">
                                Currently Available
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
