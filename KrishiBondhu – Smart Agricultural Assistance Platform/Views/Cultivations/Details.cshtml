@model Cultivation

@{
ViewData["Title"] = "Cultivation Details";
}

<div class="cultivation-details-page">

<div class="page-header">

    <div>
        <span class="section-label">CULTIVATION MANAGEMENT</span>
        <h1>🌾 Cultivation Details</h1>
        <p>View complete information about this cultivation record.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Cultivations
    </a>

</div>

<div class="details-card">

    <div class="details-top">

        <div class="record-icon">
            🌱
        </div>

        <div>
            <span class="record-label">CULTIVATION RECORD</span>
            <h2>#@Model.CultivationId</h2>
            <p>
                Detailed agricultural activity information
            </p>
        </div>

    </div>

    <div class="details-grid">

        <div class="detail-item">

            <span class="detail-label">Farm</span>

            <div class="detail-value">
                🏡 @Model.Farm?.FarmName
            </div>

        </div>

        <div class="detail-item">

            <span class="detail-label">Crop</span>

            <div class="detail-value crop-value">
                🌱 @Model.Crop?.CropName
            </div>

        </div>

        <div class="detail-item">

            <span class="detail-label">Planting Date</span>

            <div class="detail-value">
                @Model.PlantingDate.ToString("dd MMMM yyyy")
            </div>

        </div>

        <div class="detail-item">

            <span class="detail-label">Harvest Date</span>

            <div class="detail-value">

                @if (Model.HarvestDate.HasValue)
                {
                    @Model.HarvestDate.Value.ToString("dd MMMM yyyy")
                }
                else
                {
                    <span class="pending">
                        Not harvested yet
                    </span>
                }

            </div>

        </div>

        <div class="detail-item full-width">

            <span class="detail-label">Yield</span>

            <div class="yield-display">

                <strong>
                    @Model.Yield.ToString("0.##")
                </strong>

                <span>
                    units
                </span>

            </div>

        </div>

    </div>

    <div class="status-box">

        @if (Model.HarvestDate.HasValue)
        {
            <span class="status-icon">✓</span>

            <div>
                <strong>Harvest Completed</strong>
                <p>
                    This cultivation record contains a completed harvest date.
                </p>
            </div>
        }
        else
        {
            <span class="status-icon growing">🌱</span>

            <div>
                <strong>Currently Growing</strong>
                <p>
                    No harvest date has been recorded for this cultivation yet.
                </p>
            </div>
        }

    </div>

    <div class="details-actions">

        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.CultivationId"
               class="edit-btn">
                ✏ Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.CultivationId"
               class="delete-btn">
                🗑 Delete
            </a>
        }

        <a asp-action="Index"
           class="directory-btn">
            View All Cultivations
        </a>

    </div>

</div>

</div>

<style> .cultivation-details-page { max-width: 900px; margin: 0 auto; padding: 20px 10px 50px; } .page-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .section-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .page-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .page-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .details-card { background: white; border: 1px solid #e0eae2; border-radius: 20px; padding: 35px; box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08); } .details-top { display: flex; align-items: center; gap: 17px; padding-bottom: 25px; border-bottom: 1px solid #e5ece6; margin-bottom: 28px; } .record-icon { width: 68px; height: 68px; border-radius: 17px; background: #e8f4e9; display: flex; align-items: center; justify-content: center; font-size: 34px; flex-shrink: 0; } .record-label { color: #6b8e23; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; } .details-top h2 { margin: 3px 0 3px; color: #214832; font-size: 25px; } .details-top p { margin: 0; color: #7a887f; font-size: 13px; } .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; } .detail-item { background: #f7faf7; border: 1px solid #e3ebe4; border-radius: 12px; padding: 17px 18px; } .full-width { grid-column: 1 / -1; } .detail-label { display: block; color: #7b8981; font-size: 12px; margin-bottom: 7px; text-transform: uppercase; letter-spacing: 0.5px; } .detail-value { color: #294c35; font-size: 15px; font-weight: 600; } .crop-value { color: #356c3d; } .pending { color: #a27a28; font-style: italic; font-size: 13px; } .yield-display { display: flex; align-items: baseline; gap: 7px; } .yield-display strong { color: #164a2c; font-size: 24px; } .yield-display span { color: #718078; font-size: 13px; } .status-box { margin-top: 22px; padding: 15px 17px; background: #edf6ee; border: 1px solid #d8e8da; border-radius: 12px; display: flex; align-items: center; gap: 12px; } .status-icon { width: 32px; height: 32px; border-radius: 50%; background: #dceedd; color: #2f7040; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; } .status-icon.growing { font-size: 17px; } .status-box strong { color: #285737; font-size: 13px; } .status-box p { margin: 3px 0 0; color: #6e7e74; font-size: 12px; } .details-actions { display: flex; justify-content: flex-end; gap: 10px; padding-top: 25px; margin-top: 25px; border-top: 1px solid #e5ece6; } .details-actions a { text-decoration: none; padding: 10px 17px; border-radius: 9px; font-size: 13px; font-weight: 600; transition: 0.2s; } .edit-btn { background: #eef4e8; color: #5d792d; } .edit-btn:hover { background: #dfead5; color: #4c6822; } .delete-btn { background: #fff0f0; color: #a33a3a; } .delete-btn:hover { background: #f9dede; color: #8e3030; } .directory-btn { background: #164a2c; color: white; } .directory-btn:hover { background: #0f3921; color: white; } @@media (max-width: 700px) { .page-header { flex-direction: column; align-items: flex-start; } .page-header h1 { font-size: 27px; } .back-btn { width: 100%; text-align: center; box-sizing: border-box; } .details-card { padding: 25px 20px; } .details-grid { grid-template-columns: 1fr; } .full-width { grid-column: auto; } .details-actions { flex-direction: column; } .details-actions a { text-align: center; } } </style>