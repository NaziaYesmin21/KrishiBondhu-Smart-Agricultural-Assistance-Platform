@model Cultivation

@{
    ViewData["Title"] = "Delete Cultivation";
}

<div class="delete-page">

    <div class="page-header">
        <div>
            <span class="section-label">CULTIVATION MANAGEMENT</span>
            <h1>🗑 Delete Cultivation</h1>
            <p>Review the record before permanently deleting it.</p>
        </div>

        <a asp-action="Index" class="back-btn">
            ← Back to Cultivations
        </a>
    </div>

    <div class="delete-card">

        <div class="warning-header">
            <div class="warning-icon">⚠</div>

            <div>
                <h2>Delete this cultivation record?</h2>
                <p>
                    This action cannot be undone. Please review the
                    information below before continuing.
                </p>
            </div>
        </div>

        <div class="record-box">

            <div class="record-title">
                🌱 Cultivation Record #@Model.CultivationId
            </div>

            <div class="details-grid">

                <div class="detail-item">
                    <span class="detail-label">Farm</span>
                    <strong>
                        @(Model.Farm?.FarmName ?? "N/A")
                    </strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Crop</span>
                    <strong>
                        @(Model.Crop?.CropName ?? "N/A")
                    </strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Planting Date</span>
                    <strong>
                        @Model.PlantingDate.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Harvest Date</span>
                    <strong>
                        @(Model.HarvestDate.HasValue
                            ? Model.HarvestDate.Value.ToString("dd MMM yyyy")
                            : "Not harvested yet")
                    </strong>
                </div>

                <div class="detail-item full-width">
                    <span class="detail-label">Yield</span>
                    <strong>
                        @Model.Yield
                    </strong>
                </div>

            </div>

        </div>

        <div class="warning-note">
            <span>ℹ</span>
            <p>
                Deleting this record will permanently remove it from the
                cultivation database.
            </p>
        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="CultivationId" />

            <div class="form-actions">

                <a asp-action="Index" class="cancel-btn">
                    Cancel
                </a>

                <button type="submit" class="delete-btn">
                    🗑 Delete Cultivation
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    .delete-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 10px 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .section-label {
        color: #6b8e23;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: 5px 0 6px;
        color: #164a2c;
        font-size: 32px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7c72;
        font-size: 15px;
    }

    .back-btn {
        text-decoration: none;
        background: #eaf3ec;
        color: #24613c;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .back-btn:hover {
        background: #dcecdf;
        color: #164a2c;
    }

    .delete-card {
        background: white;
        border: 1px solid #e0eae2;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08);
    }

    .warning-header {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 25px;
        margin-bottom: 25px;
        border-bottom: 1px solid #e5ece6;
    }

    .warning-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #fff4df;
        color: #b87819;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .warning-header h2 {
        margin: 0 0 6px;
        color: #214832;
        font-size: 21px;
    }

    .warning-header p {
        margin: 0;
        color: #718078;
        font-size: 13px;
        line-height: 1.6;
    }

    .record-box {
        background: #f8fbf8;
        border: 1px solid #dce8de;
        border-radius: 15px;
        padding: 24px;
    }

    .record-title {
        color: #164a2c;
        font-size: 16px;
        font-weight: 700;
        padding-bottom: 17px;
        margin-bottom: 20px;
        border-bottom: 1px solid #dfe9e1;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 30px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .detail-label {
        color: #78867d;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .detail-item strong {
        color: #294b36;
        font-size: 15px;
        font-weight: 600;
    }

    .warning-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 22px;
        padding: 14px 16px;
        background: #f5f8f5;
        border-radius: 10px;
        color: #607067;
    }

    .warning-note span {
        color: #4f7d5d;
        font-weight: 700;
        font-size: 16px;
    }

    .warning-note p {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 25px;
        margin-top: 25px;
        border-top: 1px solid #e5ece6;
    }

    .form-actions a,
    .form-actions button {
        border: none;
        text-decoration: none;
        padding: 12px 21px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .cancel-btn {
        background: #edf3ee;
        color: #356047;
    }

    .cancel-btn:hover {
        background: #dfeae1;
        color: #214832;
    }

    .delete-btn {
        background: #a94442;
        color: white;
    }

    .delete-btn:hover {
        background: #873735;
    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header h1 {
            font-size: 27px;
        }

        .back-btn {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .delete-card {
            padding: 25px 20px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions a,
        .form-actions button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }

</style>