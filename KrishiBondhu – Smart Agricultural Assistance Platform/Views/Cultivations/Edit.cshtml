@model Cultivation

@{
ViewData["Title"] = "Edit Cultivation";
}

<div class="cultivation-edit-page">

<div class="page-header">

    <div>
        <span class="section-label">CULTIVATION MANAGEMENT</span>
        <h1>✏ Edit Cultivation</h1>
        <p>Update the information of this cultivation record.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Cultivations
    </a>

</div>

<div class="form-card">

    <div class="form-intro">

        <div class="intro-icon">
            🌱
        </div>

        <div>
            <span class="record-label">
                RECORD #@Model.CultivationId
            </span>

            <h2>Cultivation Information</h2>

            <p>
                Update farm, crop, dates, or yield information.
            </p>
        </div>

    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="CultivationId" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="form-grid">

            <!-- Farm -->
            <div class="form-group">

                <label asp-for="FarmId">
                    Farm
                </label>

                <select asp-for="FarmId"
                        asp-items="ViewBag.FarmId"
                        class="form-input">

                    <option value="">
                        -- Select Farm --
                    </option>

                </select>

                <span asp-validation-for="FarmId"
                      class="validation-message"></span>

            </div>

            <!-- Crop -->
            <div class="form-group">

                <label asp-for="CropId">
                    Crop
                </label>

                <select asp-for="CropId"
                        asp-items="ViewBag.CropId"
                        class="form-input">

                    <option value="">
                        -- Select Crop --
                    </option>

                </select>

                <span asp-validation-for="CropId"
                      class="validation-message"></span>

            </div>

            <!-- Planting Date -->
            <div class="form-group">

                <label asp-for="PlantingDate">
                    Planting Date
                </label>

                <input asp-for="PlantingDate"
                       type="date"
                       class="form-input" />

                <span asp-validation-for="PlantingDate"
                      class="validation-message"></span>

            </div>

            <!-- Harvest Date -->
            <div class="form-group">

                <label asp-for="HarvestDate">
                    Harvest Date
                    <span class="optional">(Optional)</span>
                </label>

                <input asp-for="HarvestDate"
                       type="date"
                       class="form-input" />

                <span asp-validation-for="HarvestDate"
                      class="validation-message"></span>

            </div>

            <!-- Yield -->
            <div class="form-group full-width">

                <label asp-for="Yield">
                    Yield
                </label>

                <div class="yield-input-wrapper">

                    <input asp-for="Yield"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-input" />

                    <span class="yield-label">
                        units
                    </span>

                </div>

                <span asp-validation-for="Yield"
                      class="validation-message"></span>

                <small>
                    Update the recorded or estimated production quantity.
                </small>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Details"
               asp-route-id="@Model.CultivationId"
               class="cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    class="update-btn">
                ✓ Update Cultivation
            </button>

        </div>

    </form>

</div>

</div>

<style> .cultivation-edit-page { max-width: 950px; margin: 0 auto; padding: 20px 10px 50px; } .page-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .section-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .page-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .page-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .form-card { background: white; border: 1px solid #e0eae2; border-radius: 20px; padding: 35px; box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08); } .form-intro { display: flex; align-items: center; gap: 17px; padding-bottom: 25px; margin-bottom: 28px; border-bottom: 1px solid #e5ece6; } .intro-icon { width: 62px; height: 62px; border-radius: 16px; background: #e8f4e9; display: flex; align-items: center; justify-content: center; font-size: 31px; flex-shrink: 0; } .record-label { display: block; color: #6b8e23; font-size: 11px; font-weight: 700; letter-spacing: 1px; margin-bottom: 3px; } .form-intro h2 { margin: 0 0 5px; color: #214832; font-size: 21px; } .form-intro p { margin: 0; color: #718078; font-size: 13px; } .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 24px; } .form-group { min-width: 0; } .full-width { grid-column: 1 / -1; } .form-group label { display: block; color: #214832; font-size: 14px; font-weight: 600; margin-bottom: 8px; } .optional { color: #89958d; font-size: 11px; font-weight: 400; margin-left: 4px; } .form-input { width: 100%; box-sizing: border-box; padding: 13px 14px; border: 1px solid #ccdcd0; border-radius: 10px; background: #fbfdfb; color: #244532; font-size: 14px; outline: none; transition: 0.2s; } .form-input:focus { border-color: #4c8a5c; box-shadow: 0 0 0 3px rgba(76, 138, 92, 0.12); background: white; } select.form-input { cursor: pointer; } .yield-input-wrapper { position: relative; } .yield-input-wrapper .form-input { padding-right: 65px; } .yield-label { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #718078; font-size: 12px; pointer-events: none; } .form-group small { display: block; margin-top: 6px; color: #89958d; font-size: 11px; } .validation-summary { color: #a33a3a; background: #fff4f4; border: 1px solid #f0d7d7; border-radius: 9px; padding: 10px 13px; margin-bottom: 20px; font-size: 13px; } .validation-message { display: block; color: #a33a3a; font-size: 12px; margin-top: 6px; } .form-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 25px; margin-top: 28px; border-top: 1px solid #e5ece6; } .form-actions a, .form-actions button { border: none; text-decoration: none; padding: 12px 21px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.2s; } .cancel-btn { background: #edf3ee; color: #356047; } .cancel-btn:hover { background: #dfeae1; color: #214832; } .update-btn { background: #164a2c; color: white; } .update-btn:hover { background: #0f3921; } @@media (max-width: 700px) { .page-header { flex-direction: column; align-items: flex-start; } .page-header h1 { font-size: 27px; } .back-btn { width: 100%; text-align: center; box-sizing: border-box; } .form-card { padding: 25px 20px; } .form-grid { grid-template-columns: 1fr; } .full-width { grid-column: auto; } .form-actions { flex-direction: column; } .form-actions a, .form-actions button { width: 100%; text-align: center; box-sizing: border-box; } } </style>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}