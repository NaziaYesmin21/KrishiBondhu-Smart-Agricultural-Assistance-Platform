@model SoilTest

@{
    ViewData["Title"] = "Add Soil Test";
}

<div class="soil-create-page">

    <div class="page-header">

        <div>
            <span class="section-label">SOIL MANAGEMENT</span>
            <h1>🧪 Add Soil Test</h1>
            <p>Record soil quality information for an agricultural farm.</p>
        </div>

        <a asp-action="Index" class="back-btn">
            ← Back to Soil Tests
        </a>

    </div>

    <div class="form-card">

        <div class="form-intro">

            <div class="intro-icon">
                🌱
            </div>

            <div>
                <span class="record-label">NEW SOIL RECORD</span>

                <h2>Soil Test Information</h2>

                <p>
                    Enter the farm and measured soil nutrient values.
                </p>
            </div>

        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-grid">

                <!-- Farm -->
                <div class="form-group full-width">

                    <label asp-for="FarmId">
                        Farm
                    </label>

                    <select asp-for="FarmId"
                            asp-items="ViewBag.FarmId"
                            class="form-input">

                        <option value="">
                            -- Select Farm --
                        </option>

                    </select>

                    <span asp-validation-for="FarmId"
                          class="validation-message"></span>

                </div>

                <!-- Test Date -->
                <div class="form-group">

                    <label asp-for="TestDate">
                        Test Date
                    </label>

                    <input asp-for="TestDate"
                           type="date"
                           class="form-input" />

                    <span asp-validation-for="TestDate"
                          class="validation-message"></span>

                </div>

                <!-- pH -->
                <div class="form-group">

                    <label asp-for="PH">
                        Soil pH
                    </label>

                    <input asp-for="PH"
                           type="number"
                           step="0.01"
                           min="0"
                           max="14"
                           class="form-input"
                           placeholder="e.g. 6.5" />

                    <span asp-validation-for="PH"
                          class="validation-message"></span>

                    <small>
                        Enter a value between 0 and 14.
                    </small>

                </div>

                <!-- Nitrogen -->
                <div class="form-group">

                    <label asp-for="Nitrogen">
                        Nitrogen
                    </label>

                    <div class="nutrient-input">

                        <input asp-for="Nitrogen"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-input"
                               placeholder="e.g. 45" />

                        <span>mg/kg</span>

                    </div>

                    <span asp-validation-for="Nitrogen"
                          class="validation-message"></span>

                </div>

                <!-- Phosphorus -->
                <div class="form-group">

                    <label asp-for="Phosphorus">
                        Phosphorus
                    </label>

                    <div class="nutrient-input">

                        <input asp-for="Phosphorus"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-input"
                               placeholder="e.g. 25" />

                        <span>mg/kg</span>

                    </div>

                    <span asp-validation-for="Phosphorus"
                          class="validation-message"></span>

                </div>

                <!-- Potassium -->
                <div class="form-group">

                    <label asp-for="Potassium">
                        Potassium
                    </label>

                    <div class="nutrient-input">

                        <input asp-for="Potassium"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-input"
                               placeholder="e.g. 35" />

                        <span>mg/kg</span>

                    </div>

                    <span asp-validation-for="Potassium"
                          class="validation-message"></span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="save-btn">
                    ✓ Save Soil Test
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    .soil-create-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 10px 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .section-label {
        color: #6b8e23;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: 5px 0 6px;
        color: #164a2c;
        font-size: 32px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7c72;
        font-size: 15px;
    }

    .back-btn {
        text-decoration: none;
        background: #eaf3ec;
        color: #24613c;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .back-btn:hover {
        background: #dcecdf;
        color: #164a2c;
    }

    .form-card {
        background: white;
        border: 1px solid #e0eae2;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08);
    }

    .form-intro {
        display: flex;
        align-items: center;
        gap: 17px;
        padding-bottom: 25px;
        margin-bottom: 28px;
        border-bottom: 1px solid #e5ece6;
    }

    .intro-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: #e8f4e9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 31px;
        flex-shrink: 0;
    }

    .record-label {
        display: block;
        color: #6b8e23;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 3px;
    }

    .form-intro h2 {
        margin: 0 0 5px;
        color: #214832;
        font-size: 21px;
    }

    .form-intro p {
        margin: 0;
        color: #718078;
        font-size: 13px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px 24px;
    }

    .form-group {
        min-width: 0;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        color: #214832;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-input {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 14px;
        border: 1px solid #ccdcd0;
        border-radius: 10px;
        background: #fbfdfb;
        color: #244532;
        font-size: 14px;
        outline: none;
        transition: 0.2s;
    }

    .form-input:focus {
        border-color: #4c8a5c;
        box-shadow: 0 0 0 3px rgba(76, 138, 92, 0.12);
        background: white;
    }

    select.form-input {
        cursor: pointer;
    }

    .nutrient-input {
        position: relative;
    }

    .nutrient-input .form-input {
        padding-right: 70px;
    }

    .nutrient-input span {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #718078;
        font-size: 11px;
        pointer-events: none;
    }

    .form-group small {
        display: block;
        margin-top: 6px;
        color: #89958d;
        font-size: 11px;
    }

    .validation-summary {
        color: #a33a3a;
        background: #fff4f4;
        border: 1px solid #f0d7d7;
        border-radius: 9px;
        padding: 10px 13px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .validation-message {
        display: block;
        color: #a33a3a;
        font-size: 12px;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 25px;
        margin-top: 28px;
        border-top: 1px solid #e5ece6;
    }

    .form-actions a,
    .form-actions button {
        border: none;
        text-decoration: none;
        padding: 12px 21px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .cancel-btn {
        background: #edf3ee;
        color: #356047;
    }

    .cancel-btn:hover {
        background: #dfeae1;
        color: #214832;
    }

    .save-btn {
        background: #164a2c;
        color: white;
    }

    .save-btn:hover {
        background: #0f3921;
    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header h1 {
            font-size: 27px;
        }

        .back-btn {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .form-card {
            padding: 25px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions a,
        .form-actions button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}