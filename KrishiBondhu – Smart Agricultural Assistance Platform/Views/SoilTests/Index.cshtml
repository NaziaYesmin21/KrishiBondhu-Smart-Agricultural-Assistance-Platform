@model IEnumerable<SoilTest>

@{
    ViewData["Title"] = "Soil Tests";
    var role = Context.Session.GetString("Role");
}

<div class="soil-page">

    <div class="page-header">

        <div>
            <span class="section-label">SOIL MANAGEMENT</span>
            <h1>🧪 Soil Tests</h1>
            <p>Monitor and manage soil quality information for agricultural farms.</p>
        </div>

        @if (role == "Admin")
        {
            <a asp-action="Create" class="add-btn">
                + Add Soil Test
            </a>
        }

    </div>

    <div class="info-strip">
        <div class="info-icon">🌱</div>

        <div>
            <strong>Soil Health Records</strong>
            <span>
                Track pH and essential nutrients including nitrogen,
                phosphorus, and potassium.
            </span>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-card">

            <div class="table-header">

                <div>
                    <h2>Soil Test Directory</h2>
                    <p>
                        @Model.Count() soil test record(s) available
                    </p>
                </div>

                <div class="record-badge">
                    @Model.Count() Records
                </div>

            </div>

            <div class="table-wrapper">

                <table class="soil-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Farm</th>
                            <th>Test Date</th>
                            <th>pH</th>
                            <th>Nitrogen</th>
                            <th>Phosphorus</th>
                            <th>Potassium</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="id-badge">
                                        #@item.SoilTestId
                                    </span>
                                </td>

                                <td>
                                    <div class="farm-cell">
                                        <div class="farm-icon">
                                            🌾
                                        </div>

                                        <strong>
                                            @(item.Farm?.FarmName ?? "N/A")
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="date-text">
                                        @item.TestDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="ph-badge">
                                        @item.PH.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    <span class="nutrient-value">
                                        @item.Nitrogen.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    <span class="nutrient-value">
                                        @item.Phosphorus.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    <span class="nutrient-value">
                                        @item.Potassium.ToString("0.##")
                                    </span>
                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@item.SoilTestId"
                                           class="details-btn">
                                            Details
                                        </a>

                                        @if (role == "Admin")
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.SoilTestId"
                                               class="edit-btn">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.SoilTestId"
                                               class="delete-btn">
                                                Delete
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="empty-card">

            <div class="empty-icon">
                🧪
            </div>

            <h2>No Soil Test Records</h2>

            <p>
                There are currently no soil test records in the database.
            </p>

            @if (role == "Admin")
            {
                <a asp-action="Create" class="empty-btn">
                    + Add First Soil Test
                </a>
            }

        </div>
    }

</div>

<style>

    .soil-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 20px 10px 50px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .section-label {
        color: #6b8e23;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: 5px 0 6px;
        color: #164a2c;
        font-size: 32px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7c72;
        font-size: 15px;
    }

    .add-btn {
        text-decoration: none;
        background: #164a2c;
        color: white;
        padding: 12px 19px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        white-space: nowrap;
        transition: 0.2s;
    }

    .add-btn:hover {
        background: #0f3921;
        color: white;
    }

    .info-strip {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #edf6ee;
        border: 1px solid #d7e8da;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 22px;
    }

    .info-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .info-strip strong {
        display: block;
        color: #214832;
        font-size: 14px;
        margin-bottom: 3px;
    }

    .info-strip span {
        display: block;
        color: #66786d;
        font-size: 12px;
    }

    .table-card {
        background: white;
        border: 1px solid #e0eae2;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(30, 75, 45, 0.07);
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px 25px;
        border-bottom: 1px solid #e5ece6;
    }

    .table-header h2 {
        margin: 0 0 4px;
        color: #214832;
        font-size: 19px;
    }

    .table-header p {
        margin: 0;
        color: #7a877f;
        font-size: 12px;
    }

    .record-badge {
        background: #eaf3ec;
        color: #356047;
        padding: 8px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .soil-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

    .soil-table th {
        background: #f6f9f6;
        color: #607067;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 14px 15px;
        text-align: left;
        white-space: nowrap;
    }

    .soil-table td {
        padding: 16px 15px;
        border-top: 1px solid #edf1ed;
        color: #365341;
        font-size: 13px;
        vertical-align: middle;
    }

    .soil-table tbody tr:hover {
        background: #fbfdfb;
    }

    .id-badge {
        background: #eef5ef;
        color: #356047;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
    }

    .farm-cell {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 130px;
    }

    .farm-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: #edf6ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .farm-cell strong {
        color: #294b36;
        font-size: 13px;
    }

    .date-text {
        color: #607067;
        white-space: nowrap;
    }

    .ph-badge {
        display: inline-block;
        min-width: 34px;
        text-align: center;
        background: #e8f3e9;
        color: #24613c;
        padding: 6px 8px;
        border-radius: 7px;
        font-weight: 700;
        font-size: 12px;
    }

    .nutrient-value {
        color: #42604d;
        font-weight: 600;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-buttons a {
        text-decoration: none;
        padding: 7px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .details-btn {
        background: #edf4f0;
        color: #356047;
    }

    .details-btn:hover {
        background: #dfeae2;
        color: #214832;
    }

    .edit-btn {
        background: #edf4f8;
        color: #3d667a;
    }

    .edit-btn:hover {
        background: #dcebf2;
        color: #294f61;
    }

    .delete-btn {
        background: #f9eded;
        color: #a94442;
    }

    .delete-btn:hover {
        background: #f2dddd;
        color: #873735;
    }

    .empty-card {
        background: white;
        border: 1px solid #e0eae2;
        border-radius: 18px;
        padding: 65px 25px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(30, 75, 45, 0.07);
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        background: #edf6ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        margin: 0 auto 18px;
    }

    .empty-card h2 {
        margin: 0 0 8px;
        color: #214832;
        font-size: 21px;
    }

    .empty-card p {
        margin: 0 0 22px;
        color: #78867d;
        font-size: 13px;
    }

    .empty-btn {
        display: inline-block;
        text-decoration: none;
        background: #164a2c;
        color: white;
        padding: 11px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
    }

    .empty-btn:hover {
        background: #0f3921;
        color: white;
    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .add-btn {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .table-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .info-strip {
            align-items: flex-start;
        }
    }

</style>