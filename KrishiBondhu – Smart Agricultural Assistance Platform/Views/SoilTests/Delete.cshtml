
@model SoilTest

@{
    ViewData["Title"] = "Delete Soil Test";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h2 class="fw-bold mb-1" style="color:#174A32;">
                <i class="bi bi-trash3 me-2"></i>
                Delete Soil Test
            </h2>

            <p class="text-muted mb-0">
                Review the record before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-success px-4">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Soil Tests

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">


        <!-- Header -->
        <div class="delete-header p-4">

            <div class="d-flex align-items-center">

                <div class="delete-icon me-3">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>

                <div>

                    <h4 class="mb-1 fw-bold">
                        Confirm Deletion
                    </h4>

                    <small>
                        Soil Test ID: @Model.SoilTestId
                    </small>

                </div>

            </div>

        </div>


        <!-- Body -->
        <div class="card-body p-4">

            <div class="warning-box mb-4">

                <i class="bi bi-exclamation-circle"></i>

                <div>

                    <strong>
                        Are you sure you want to delete this soil test?
                    </strong>

                    <p class="mb-0">
                        This action will permanently remove the record
                        from the database and cannot be undone.
                    </p>

                </div>

            </div>


            <!-- Record Information -->

            <div class="row g-3">


                <!-- Farm -->
                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon">

                            <i class="bi bi-house-door"></i>

                        </div>

                        <div>

                            <small>
                                Farm
                            </small>

                            <strong>
                                @(Model.Farm?.FarmName ?? "N/A")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Date -->
                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon">

                            <i class="bi bi-calendar3"></i>

                        </div>

                        <div>

                            <small>
                                Test Date
                            </small>

                            <strong>
                                @Model.TestDate.ToString("dd MMMM yyyy")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- pH -->
                <div class="col-md-4">

                    <div class="metric-box">

                        <i class="bi bi-droplet-half"></i>

                        <small>
                            Soil pH
                        </small>

                        <strong>
                            @Model.PH
                        </strong>

                    </div>

                </div>


                <!-- Nitrogen -->
                <div class="col-md-4">

                    <div class="metric-box">

                        <i class="bi bi-flower1"></i>

                        <small>
                            Nitrogen
                        </small>

                        <strong>
                            @Model.Nitrogen
                        </strong>

                        <span>
                            mg/kg
                        </span>

                    </div>

                </div>


                <!-- Phosphorus -->
                <div class="col-md-4">

                    <div class="metric-box">

                        <i class="bi bi-tree"></i>

                        <small>
                            Phosphorus
                        </small>

                        <strong>
                            @Model.Phosphorus
                        </strong>

                        <span>
                            mg/kg
                        </span>

                    </div>

                </div>


                <!-- Potassium -->
                <div class="col-md-4">

                    <div class="metric-box">

                        <i class="bi bi-lightning-charge"></i>

                        <small>
                            Potassium
                        </small>

                        <strong>
                            @Model.Potassium
                        </strong>

                        <span>
                            mg/kg
                        </span>

                    </div>

                </div>

            </div>


            <!-- Actions -->

            <div class="border-top mt-4 pt-4 d-flex gap-2 flex-wrap">

                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           asp-for="SoilTestId" />

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Yes, Delete Test

                    </button>

                </form>


                <a asp-action="Details"
                   asp-route-id="@Model.SoilTestId"
                   class="btn btn-outline-secondary px-4">

                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    .delete-header {
        background: linear-gradient(
            135deg,
            #174A32,
            #2E7D32
        );

        color: white;
    }

    .delete-icon {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 18px;
        background: #fff8e8;
        border: 1px solid #f0dfad;
        border-radius: 14px;
        color: #735b22;
    }

    .warning-box > i {
        font-size: 23px;
        margin-top: 2px;
        color: #b18419;
    }

    .warning-box strong {
        display: block;
        margin-bottom: 4px;
        color: #654f1d;
    }

    .warning-box p {
        font-size: 13px;
        color: #806d3b;
    }

    .detail-box {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        background: #f7fbf8;
        border: 1px solid #e2eee5;
        border-radius: 14px;
        height: 100%;
    }

    .detail-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #e5f3e8;
        color: #174A32;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .detail-box small {
        display: block;
        color: #718078;
        font-size: 11px;
        margin-bottom: 3px;
    }

    .detail-box strong {
        display: block;
        color: #294638;
        font-size: 14px;
    }

    .metric-box {
        text-align: center;
        padding: 20px 12px;
        background: #f7fbf8;
        border: 1px solid #e2eee5;
        border-radius: 14px;
    }

    .metric-box > i {
        display: block;
        color: #174A32;
        font-size: 23px;
        margin-bottom: 8px;
    }

    .metric-box small {
        display: block;
        color: #718078;
        font-size: 11px;
    }

    .metric-box strong {
        display: block;
        color: #174A32;
        font-size: 22px;
        margin-top: 3px;
    }

    .metric-box span {
        display: block;
        color: #7a877f;
        font-size: 10px;
        margin-top: 2px;
    }

    .btn-danger {
        background-color: #a94442;
        border-color: #a94442;
    }

    .btn-danger:hover {
        background-color: #873735;
        border-color: #873735;
    }

    @@media (max-width: 576px) {

        .card-body {
            padding: 20px !important;
        }

    }

</style>
```
