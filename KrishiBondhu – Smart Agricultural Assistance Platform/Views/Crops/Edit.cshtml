@model Crop

@{
ViewData["Title"] = "Edit Crop";
}

<div class="crop-edit-page">

<div class="crop-edit-header">
    <div>
        <span class="crop-label">CROP MANAGEMENT</span>
        <h1>✏ Edit Crop</h1>
        <p>Update the information of this registered crop.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Crops
    </a>
</div>

<div class="crop-edit-card">

    <div class="edit-icon">
        🌱
    </div>

    <div class="edit-intro">
        <h2>Crop Information</h2>
        <p>
            Crop ID: <strong>#@Model.CropId</strong>
        </p>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="CropId" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="form-group">

            <label asp-for="CropName">
                Crop Name
            </label>

            <input asp-for="CropName"
                   class="crop-input"
                   autocomplete="off" />

            <span asp-validation-for="CropName"
                  class="validation-message"></span>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    class="update-btn">
                ✓ Update Crop
            </button>

        </div>

    </form>

</div>

</div>

<style> .crop-edit-page { max-width: 850px; margin: 0 auto; padding: 20px 10px 50px; } .crop-edit-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .crop-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .crop-edit-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .crop-edit-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .crop-edit-card { background: white; border: 1px solid #e1ebe3; border-radius: 20px; padding: 35px; box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08); } .edit-icon { width: 68px; height: 68px; border-radius: 17px; background: #e8f4e9; display: flex; align-items: center; justify-content: center; font-size: 34px; margin-bottom: 20px; } .edit-intro h2 { margin: 0 0 5px; color: #214832; font-size: 22px; } .edit-intro p { margin: 0 0 28px; color: #718078; font-size: 14px; } .edit-intro strong { color: #356047; } .form-group { margin-bottom: 25px; } .form-group label { display: block; color: #214832; font-size: 14px; font-weight: 600; margin-bottom: 8px; } .crop-input { width: 100%; box-sizing: border-box; padding: 13px 15px; border: 1px solid #ccdcd0; border-radius: 10px; font-size: 15px; color: #244532; background: #fbfdfb; outline: none; transition: 0.2s; } .crop-input:focus { border-color: #4c8a5c; box-shadow: 0 0 0 3px rgba(76, 138, 92, 0.12); background: white; } .validation-summary { color: #a33a3a; background: #fff4f4; border: 1px solid #f0d7d7; border-radius: 9px; padding: 10px 13px; margin-bottom: 18px; font-size: 13px; } .validation-message { display: block; color: #a33a3a; font-size: 12px; margin-top: 6px; } .form-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 22px; border-top: 1px solid #e7eee8; } .form-actions a, .form-actions button { border: none; text-decoration: none; padding: 11px 20px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.2s; } .cancel-btn { background: #edf3ee; color: #356047; } .cancel-btn:hover { background: #dfeae1; color: #214832; } .update-btn { background: #164a2c; color: white; } .update-btn:hover { background: #0f3921; } @@media (max-width: 650px) { .crop-edit-header { flex-direction: column; align-items: flex-start; } .crop-edit-header h1 { font-size: 27px; } .back-btn { width: 100%; text-align: center; box-sizing: border-box; } .crop-edit-card { padding: 25px 20px; } .form-actions { flex-direction: column; } .form-actions a, .form-actions button { width: 100%; text-align: center; box-sizing: border-box; } } </style>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}