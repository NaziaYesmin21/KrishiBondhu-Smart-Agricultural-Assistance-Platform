@model Crop

@{
ViewData["Title"] = "Crop Details";
}

<div class="crop-details-page">

<div class="crop-details-header">
    <div>
        <span class="crop-label">CROP MANAGEMENT</span>
        <h1>🌾 Crop Details</h1>
        <p>View complete information about this registered crop.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Crops
    </a>
</div>

<div class="crop-details-card">

    <div class="crop-main-icon">
        🌱
    </div>

    <div class="crop-title-section">
        <span class="crop-id-badge">Crop #@Model.CropId</span>

        <h2>@Model.CropName</h2>

        <p>
            This crop is currently registered in the KrishiBondhu
            agricultural database.
        </p>
    </div>

    <div class="crop-info">

        <div class="info-box">
            <span class="info-label">Crop ID</span>
            <strong>#@Model.CropId</strong>
        </div>

        <div class="info-box">
            <span class="info-label">Crop Name</span>
            <strong>@Model.CropName</strong>
        </div>

    </div>

    <div class="crop-actions">

        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.CropId"
               class="edit-btn">
                ✏ Edit Crop
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.CropId"
               class="delete-btn">
                🗑 Delete Crop
            </a>
        }

        <a asp-action="Index"
           class="list-btn">
            🌾 Crop Directory
        </a>

    </div>

</div>

</div>

<style> .crop-details-page { max-width: 900px; margin: 0 auto; padding: 20px 10px 50px; } .crop-details-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .crop-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .crop-details-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .crop-details-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .crop-details-card { background: white; border: 1px solid #e1ebe3; border-radius: 20px; padding: 38px; box-shadow: 0 8px 25px rgba(30, 75, 45, 0.08); } .crop-main-icon { width: 82px; height: 82px; border-radius: 20px; background: #e7f3e8; display: flex; align-items: center; justify-content: center; font-size: 42px; margin-bottom: 20px; } .crop-title-section { margin-bottom: 30px; } .crop-id-badge { display: inline-block; background: #edf5ee; color: #2d6842; padding: 6px 11px; border-radius: 8px; font-size: 12px; font-weight: 700; margin-bottom: 10px; } .crop-title-section h2 { margin: 0 0 8px; color: #183f29; font-size: 28px; } .crop-title-section p { margin: 0; color: #718078; font-size: 14px; } .crop-info { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 30px; } .info-box { background: #f7faf7; border: 1px solid #e3ece4; border-radius: 13px; padding: 18px; } .info-label { display: block; color: #77847c; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 7px; } .info-box strong { color: #214832; font-size: 16px; } .crop-actions { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid #e5eee7; } .crop-actions a { text-decoration: none; padding: 11px 17px; border-radius: 10px; font-size: 14px; font-weight: 600; transition: 0.2s; } .edit-btn { background: #e5f2e8; color: #24613c; } .edit-btn:hover { background: #d4e9d9; color: #164a2c; } .delete-btn { background: #fbe8e8; color: #a33a3a; } .delete-btn:hover { background: #f6d6d6; color: #872d2d; } .list-btn { background: #164a2c; color: white; } .list-btn:hover { background: #0f3921; color: white; } @@media (max-width: 650px) { .crop-details-header { flex-direction: column; align-items: flex-start; } .crop-details-header h1 { font-size: 27px; } .crop-details-card { padding: 25px 20px; } .crop-info { grid-template-columns: 1fr; } .crop-actions { flex-direction: column; } .crop-actions a { text-align: center; } } </style>