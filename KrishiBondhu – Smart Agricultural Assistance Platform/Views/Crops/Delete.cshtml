@model Crop

@{
ViewData["Title"] = "Delete Crop";
}

<div class="crop-delete-page">

<div class="crop-delete-header">
    <div>
        <span class="crop-label">CROP MANAGEMENT</span>
        <h1>🗑 Delete Crop</h1>
        <p>Review the crop information before removing it.</p>
    </div>

    <a asp-action="Index" class="back-btn">
        ← Back to Crops
    </a>
</div>

<div class="delete-card">

    <div class="warning-icon">
        ⚠
    </div>

    <h2>Delete this crop?</h2>

    <p class="warning-text">
        You are about to permanently remove this crop record
        from the KrishiBondhu database.
    </p>

    <div class="crop-info">

        <div class="info-row">
            <span>Crop ID</span>
            <strong>#@Model.CropId</strong>
        </div>

        <div class="info-row">
            <span>Crop Name</span>
            <strong>@Model.CropName</strong>
        </div>

    </div>

    <div class="danger-note">
        <span>⚠</span>
        <div>
            <strong>This action cannot be undone.</strong>
            <p>
                Make sure this is the correct crop record before continuing.
            </p>
        </div>
    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="CropId" />

        <div class="delete-actions">

            <a asp-action="Index"
               class="cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    class="delete-btn">
                🗑 Delete Crop
            </button>

        </div>

    </form>

</div>

</div>

<style> .crop-delete-page { max-width: 850px; margin: 0 auto; padding: 20px 10px 50px; } .crop-delete-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 28px; } .crop-label { color: #6b8e23; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; } .crop-delete-header h1 { margin: 5px 0 6px; color: #164a2c; font-size: 32px; font-weight: 700; } .crop-delete-header p { margin: 0; color: #6b7c72; font-size: 15px; } .back-btn { text-decoration: none; background: #eaf3ec; color: #24613c; padding: 11px 18px; border-radius: 10px; font-weight: 600; white-space: nowrap; } .back-btn:hover { background: #dcecdf; color: #164a2c; } .delete-card { background: white; border: 1px solid #eadede; border-radius: 20px; padding: 38px; box-shadow: 0 8px 25px rgba(80, 50, 50, 0.08); text-align: center; } .warning-icon { width: 72px; height: 72px; margin: 0 auto 20px; border-radius: 50%; background: #fff3df; color: #c47a18; display: flex; align-items: center; justify-content: center; font-size: 34px; } .delete-card h2 { margin: 0 0 8px; color: #263c2d; font-size: 25px; } .warning-text { max-width: 570px; margin: 0 auto 28px; color: #718078; line-height: 1.6; font-size: 14px; } .crop-info { max-width: 600px; margin: 0 auto 22px; background: #f5f9f5; border: 1px solid #dfe9e0; border-radius: 14px; overflow: hidden; text-align: left; } .info-row { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #e2ebe3; } .info-row:last-child { border-bottom: none; } .info-row span { color: #718078; font-size: 14px; } .info-row strong { color: #214832; font-size: 15px; } .danger-note { max-width: 600px; margin: 0 auto 28px; padding: 13px 16px; background: #fff7e9; border: 1px solid #f0dfbb; border-radius: 11px; display: flex; gap: 12px; text-align: left; color: #795b27; } .danger-note > span { font-size: 18px; } .danger-note strong { font-size: 13px; } .danger-note p { margin: 3px 0 0; font-size: 12px; color: #8a7040; } .delete-actions { display: flex; justify-content: center; gap: 12px; padding-top: 22px; border-top: 1px solid #e7eee8; } .delete-actions a, .delete-actions button { border: none; text-decoration: none; padding: 12px 22px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.2s; } .cancel-btn { background: #edf3ee; color: #356047; } .cancel-btn:hover { background: #dfeae1; color: #214832; } .delete-btn { background: #b33a3a; color: white; } .delete-btn:hover { background: #922f2f; } @@media (max-width: 650px) { .crop-delete-header { flex-direction: column; align-items: flex-start; } .crop-delete-header h1 { font-size: 27px; } .back-btn { width: 100%; text-align: center; box-sizing: border-box; } .delete-card { padding: 28px 20px; } .info-row { gap: 20px; } .delete-actions { flex-direction: column; } .delete-actions a, .delete-actions button { width: 100%; box-sizing: border-box; } } </style>