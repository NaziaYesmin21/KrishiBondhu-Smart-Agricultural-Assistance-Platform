
@{
    ViewData["Title"] = "AI Agricultural Assistant";
}

<style>

    .ai-page {
        max-width: 1000px;
        margin: 35px auto;
    }

    .ai-header {
        background: linear-gradient(135deg, #176b45, #2f8f62);
        color: white;
        padding: 35px;
        border-radius: 20px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(31, 77, 52, 0.12);
    }

        .ai-header h1 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .ai-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 14px;
        }

    .ai-card {
        background: white;
        border: 1px solid #e1e9e4;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 6px 18px rgba(31, 77, 52, 0.06);
        margin-bottom: 20px;
    }

    .ai-label {
        font-weight: 700;
        color: #244536;
        margin-bottom: 10px;
        display: block;
    }

    .ai-input {
        width: 100%;
        min-height: 120px;
        border: 1px solid #d7e1db;
        border-radius: 12px;
        padding: 15px;
        font-size: 14px;
        resize: vertical;
        outline: none;
    }

        .ai-input:focus {
            border-color: #2f8f62;
            box-shadow: 0 0 0 3px rgba(47, 143, 98, 0.10);
        }

    .ai-button {
        margin-top: 15px;
        background: #176b45;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
    }

        .ai-button:hover {
            background: #125537;
        }

    .ai-answer {
        background: #f4faf6;
        border-left: 5px solid #2f8f62;
        padding: 18px;
        border-radius: 10px;
        color: #244536;
        line-height: 1.7;
        margin-top: 20px;
    }

    .ai-question {
        background: #f8faf9;
        padding: 15px;
        border-radius: 10px;
        margin-top: 15px;
        color: #43534b;
    }

    .example-title {
        font-weight: 700;
        color: #244536;
        margin-bottom: 15px;
    }

    .example-item {
        display: inline-block;
        background: #edf7f1;
        color: #176b45;
        padding: 9px 13px;
        border-radius: 20px;
        margin: 5px;
        font-size: 12px;
    }

</style>


<div class="container ai-page">

    <!-- Header -->

    <div class="ai-header">

        <h1>🤖 AI Agricultural Assistant</h1>

        <p>
            Ask questions about crops, soil, diseases, cultivation,
            and agricultural practices.
        </p>

    </div>


    <!-- Question Card -->

    <div class="ai-card">

        <form asp-controller="AIAssistant"
              asp-action="Ask"
              method="post">

            <label class="ai-label">
                🌱 Ask Your Agricultural Question
            </label>

            <textarea name="question"
                      class="ai-input"
                      placeholder="Example: My rice plant leaves have yellow spots. What should I do?">@ViewBag.Question</textarea>

            <button type="submit" class="ai-button">
                🤖 Ask Assistant
            </button>

        </form>


        @if (ViewBag.Answer != null)
        {
            <div class="ai-question">

                <strong>Your Question:</strong>

                <br />

                @ViewBag.Question

            </div>


            <div class="ai-answer">

                <strong>🤖 Assistant Response</strong>

                <br /><br />

                @ViewBag.Answer

            </div>
        }

    </div>


    <!-- Example Questions -->

    <div class="ai-card">

        <div class="example-title">
            💡 Example Questions
        </div>

        <span class="example-item">
            🌾 Rice leaf disease
        </span>

        <span class="example-item">
            🌱 Best crop for soil
        </span>

        <span class="example-item">
            💧 How much water is needed?
        </span>

        <span class="example-item">
            🐛 Pest control
        </span>

        <span class="example-item">
            🌿 Fertilizer recommendation
        </span>

    </div>


    <!-- Information -->

    <div class="ai-card">

        <strong>ℹ️ About AI Agricultural Assistant</strong>

        <p class="mt-2 mb-0 text-muted">

            This assistant is designed to provide simple agricultural
            guidance based on the farmer's questions. Real AI-powered
            responses will be integrated in the next stage.

        </p>

    </div>

</div>

