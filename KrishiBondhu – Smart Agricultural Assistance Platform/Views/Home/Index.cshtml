@{
    ViewData["Title"] = "KrishiBondhu Dashboard";

    var username = ViewBag.Username as string ?? "Guest";
    var role = ViewBag.Role as string ?? "User";

    int farmerCount = ViewBag.FarmerCount ?? 0;
    int farmCount = ViewBag.FarmCount ?? 0;
    int cropCount = ViewBag.CropCount ?? 0;
    int cultivationCount = ViewBag.CultivationCount ?? 0;
    int soilTestCount = ViewBag.SoilTestCount ?? 0;
    int diseaseCount = ViewBag.DiseaseCount ?? 0;

    var cropStatistics =
        ViewBag.CropStatistics as List<CropStatistics>
        ?? new List<CropStatistics>();

    var diseaseStatistics =
        ViewBag.DiseaseStatistics as List<DiseaseStatistics>
        ?? new List<DiseaseStatistics>();

    var upcomingHarvests =
        ViewBag.UpcomingHarvests as List<Cultivation>
        ?? new List<Cultivation>();

    int maxCropCount = cropStatistics.Any()
        ? cropStatistics.Max(x => x.Count) : 1;

    int maxDiseaseCount = diseaseStatistics.Any()
        ? diseaseStatistics.Max(x => x.Count) : 1;
}

<style>
    /* ================================
           KRISHIBONDHU DASHBOARD THEME
           Light Green + White
        ================================= */

    .kb-dashboard {
        padding: 25px 0 45px;
        background: #f5faf6;
        min-height: 100vh;
        color: #244536;
    }

    .kb-dashboard-container {
        max-width: 1320px;
        margin: auto;
        padding: 0 20px;
    }

    .kb-section {
        margin-bottom: 27px;
    }

    .kb-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .kb-section-title {
        margin: 0;
        color: #205b39;
        font-size: 21px;
        font-weight: 750;
    }

    .kb-section-description {
        margin: 5px 0 0;
        color: #718078;
        font-size: 13px;
        line-height: 1.6;
    }

    /* HERO BANNER */

    .kb-dashboard-hero {
        position: relative;
        overflow: hidden;
        min-height: 245px;
        border-radius: 20px;
        padding: 34px 38px;
        display: flex;
        align-items: center;
        margin-bottom: 27px;
        background: linear-gradient(115deg, #103824, #155b3a 55%, #287b50);
        box-shadow: 0 12px 28px rgba(20, 65, 43, 0.12);
    }

    .kb-hero-circle-one,
    .kb-hero-circle-two {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.10);
        pointer-events: none;
    }

    .kb-hero-circle-one {
        width: 350px;
        height: 350px;
        right: -100px;
        top: -180px;
    }

    .kb-hero-circle-two {
        width: 230px;
        height: 230px;
        right: 80px;
        bottom: -170px;
    }

    .kb-hero-leaf {
        position: absolute;
        right: 65px;
        bottom: 30px;
        font-size: 76px;
        opacity: 0.13;
        transform: rotate(-12deg);
        pointer-events: none;
    }

    .kb-hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    .kb-welcome {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 13px;
        border-radius: 30px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.15);
        color: white;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .kb-online-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #8de2ae;
    }

    .kb-hero-title {
        margin: 0;
        color: white;
        font-size: 38px;
        line-height: 1.2;
        font-weight: 750;
        letter-spacing: -0.7px;
    }

        .kb-hero-title span {
            color: #a8e6bd;
        }

    .kb-hero-description {
        margin: 13px 0 20px;
        max-width: 680px;
        color: rgba(255,255,255,0.83);
        font-size: 14px;
        line-height: 1.8;
    }

    .kb-hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .kb-hero-primary,
    .kb-hero-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 16px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .kb-hero-primary {
        background: #ffffff;
        color: #155b3a;
        font-weight: 700;
    }

        .kb-hero-primary:hover {
            color: #155b3a;
            background: #eaf6ed;
            transform: translateY(-2px);
        }

    .kb-hero-secondary {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.25);
        color: white;
        font-weight: 650;
    }

        .kb-hero-secondary:hover {
            color: white;
            background: rgba(255,255,255,0.17);
        }

    /* STATISTICS CARDS */

    .kb-stat-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 13px;
    }

    .kb-stat {
        position: relative;
        background: #ffffff;
        border: 1px solid #dceadd;
        border-radius: 14px;
        padding: 14px;
        min-height: 116px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(36, 90, 50, 0.045);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .kb-stat:nth-child(odd) {
            background: #eaf5ec;
            border-color: #d3e8d8;
        }

        .kb-stat:nth-child(even) {
            background: #ffffff;
        }

        .kb-stat:hover {
            transform: translateY(-3px);
            border-color: #a9d0b5;
            box-shadow: 0 8px 18px rgba(31, 77, 52, 0.10);
        }

    .kb-stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .kb-stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #d4ead9;
        font-size: 16px;
    }

    .kb-stat-arrow {
        color: #7b9b85;
        font-size: 12px;
    }

    .kb-stat-number {
        color: #173d2b;
        font-size: 25px;
        line-height: 1.1;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .kb-stat-label {
        color: #52685a;
        font-size: 12px;
        font-weight: 600;
        margin-top: 6px;
        line-height: 1.45;
    }

    .kb-stat-bottom {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        background: #b9d9c2;
    }

    /* ANALYTICS */

    .kb-analytics-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .kb-chart-card {
        background: #ffffff;
        border: 1px solid #dceadd;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 16px rgba(36, 90, 50, 0.045);
        min-width: 0;
    }

    .kb-chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .kb-chart-title {
        margin: 0;
        color: #244536;
        font-size: 16px;
        font-weight: 750;
    }

    .kb-chart-subtitle {
        margin: 5px 0 0;
        color: #748078;
        font-size: 12px;
        line-height: 1.5;
    }

    .kb-chart-badge {
        background: #e3f2e7;
        color: #176b45;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .kb-chart-row {
        margin-bottom: 16px;
    }

        .kb-chart-row:last-child {
            margin-bottom: 0;
        }

    .kb-chart-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 7px;
    }

    .kb-chart-label {
        color: #40594b;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .kb-chart-value {
        color: #176b45;
        font-size: 12px;
        font-weight: 750;
    }

    .kb-chart-track {
        width: 100%;
        height: 8px;
        background: #edf3ef;
        border-radius: 20px;
        overflow: hidden;
    }

    .kb-chart-bar {
        height: 100%;
        background: linear-gradient(90deg, #176b45, #65b582);
        border-radius: 20px;
        min-width: 4px;
        transition: width 0.4s ease;
    }

    .kb-chart-bar-disease {
        background: linear-gradient(90deg, #477b61, #9ac8a8);
    }

    .kb-empty-chart,
    .kb-harvest-empty {
        padding: 28px 14px;
        text-align: center;
        background: #f2f8f3;
        border-radius: 11px;
        color: #748078;
        font-size: 13px;
        line-height: 1.7;
    }

    /* FARM PERFORMANCE */

    .kb-performance-card,
    .kb-harvest-card {
        background: #ffffff;
        border: 1px solid #dceadd;
        border-radius: 15px;
        padding: 18px;
        box-shadow: 0 5px 16px rgba(36, 90, 50, 0.045);
    }

    .kb-performance-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 11px;
    }

    .kb-performance-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px;
        background: #f0f7f1;
        border: 1px solid #e0ece2;
        border-radius: 11px;
        min-width: 0;
    }

    .kb-performance-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dcefe1;
        font-size: 17px;
    }

    .kb-performance-label {
        color: #748078;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .kb-performance-value {
        color: #173d2b;
        font-size: 20px;
        font-weight: 750;
        line-height: 1.2;
    }

    /* HARVEST REMINDERS */

    .kb-harvest-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 13px;
        margin-bottom: 9px;
        background: #f7faf7;
        border: 1px solid #e0ece2;
        border-radius: 11px;
    }

        .kb-harvest-item:last-child {
            margin-bottom: 0;
        }

    .kb-harvest-date {
        color: #244536;
        font-size: 13px;
        font-weight: 700;
    }

    .kb-harvest-id {
        color: #748078;
        font-size: 11px;
        margin-top: 5px;
    }

    .kb-harvest-badge {
        background: #e3f2e7;
        color: #176b45;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* MANAGEMENT MODULES */

    .kb-module-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 13px;
    }

    .kb-module {
        display: block;
        background: #ffffff;
        border: 1px solid #dceadd;
        border-radius: 14px;
        padding: 18px;
        text-decoration: none;
        transition: all 0.2s ease;
        min-width: 0;
        box-shadow: 0 3px 12px rgba(36, 90, 50, 0.035);
    }

        .kb-module:hover {
            background: #f0f8f1;
            border-color: #b7d9c0;
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(36, 90, 50, 0.09);
        }

    .kb-module-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .kb-module-icon {
        width: 39px;
        height: 39px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e3f2e7;
        font-size: 19px;
    }

    .kb-module-arrow {
        color: #8da395;
        font-size: 17px;
        transition: color 0.2s ease;
    }

    .kb-module:hover .kb-module-arrow {
        color: #176b45;
    }

    .kb-module h3 {
        margin: 0 0 7px;
        color: #244536;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.4;
    }

    .kb-module p {
        margin: 0;
        color: #718078;
        font-size: 12px;
        line-height: 1.7;
    }

    /* ACCOUNT INFORMATION */

    .kb-system-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: #e6f2e8;
        border: 1px solid #cfe2d5;
        border-radius: 13px;
        padding: 15px 18px;
        margin-top: 27px;
    }

    .kb-system-left {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .kb-system-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 9px;
        background: #cce4d3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .kb-system-title {
        color: #244536;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .kb-system-text {
        color: #6e7e74;
        font-size: 11px;
        line-height: 1.6;
    }

    .kb-role {
        background: #176b45;
        color: #ffffff;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* RESPONSIVE DESIGN */

    @@media (max-width: 1200px) {
        .kb-stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .kb-performance-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 850px) {
        .kb-dashboard-container {
            padding: 0 16px;
        }

        .kb-dashboard-hero {
            padding: 30px 25px;
        }

        .kb-hero-title {
            font-size: 32px;
        }

        .kb-analytics-grid {
            grid-template-columns: 1fr;
        }

        .kb-module-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .kb-dashboard {
            padding-top: 18px;
        }

        .kb-dashboard-container {
            padding: 0 12px;
        }

        .kb-dashboard-hero {
            min-height: auto;
            padding: 25px 19px;
            border-radius: 16px;
        }

        .kb-hero-title {
            font-size: 27px;
        }

        .kb-hero-description {
            font-size: 13px;
        }

        .kb-hero-leaf {
            right: 12px;
            bottom: 10px;
            font-size: 50px;
        }

        .kb-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
        }

        .kb-stat {
            padding: 12px;
            min-height: 105px;
        }

        .kb-stat-number {
            font-size: 23px;
        }

        .kb-performance-grid,
        .kb-module-grid {
            grid-template-columns: 1fr;
        }

        .kb-chart-card {
            padding: 15px;
        }

        .kb-harvest-item {
            align-items: flex-start;
            flex-direction: column;
        }

        .kb-system-info {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 350px) {
        .kb-stat-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="kb-dashboard">
    <div class="kb-dashboard-container">

        <!-- HERO -->
        <section class="kb-dashboard-hero">
            <div class="kb-hero-circle-one"></div>
            <div class="kb-hero-circle-two"></div>
            <div class="kb-hero-leaf">🌿</div>

            <div class="kb-hero-content">
                <div class="kb-welcome">
                    <span class="kb-online-dot"></span>
                    Welcome back, @username
                    <span>•</span>
                    @role
                </div>

                <h1 class="kb-hero-title">
                    Agriculture <span>Made Organized.</span>
                </h1>

                <p class="kb-hero-description">
                    KrishiBondhu is a smart agricultural assistance platform
                    designed to organize farmer, farm, crop, cultivation,
                    soil and disease records in one connected system.
                </p>

                <div class="kb-hero-actions">
                    @if (role == "Admin")
                    {
                        <a asp-controller="Farmers"
                           asp-action="Create"
                           class="kb-hero-primary">
                            ＋ Add Farmer
                        </a>
                    }

                    <a asp-controller="Farmers"
                       asp-action="Index"
                       class="kb-hero-secondary">
                        👨‍🌾 View Farmers
                    </a>
                </div>
            </div>
        </section>

        <!-- SYSTEM OVERVIEW -->
        <section class="kb-section">
            <div class="kb-section-heading">
                <div>
                    <h2 class="kb-section-title">System Overview</h2>
                    <p class="kb-section-description">
                        Current records stored in KrishiBondhu
                    </p>
                </div>
            </div>

            <div class="kb-stat-grid">
                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">👨‍🌾</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@farmerCount</div>
                    <div class="kb-stat-label">Registered Farmers</div>
                    <div class="kb-stat-bottom"></div>
                </div>

                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">🚜</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@farmCount</div>
                    <div class="kb-stat-label">Farms</div>
                    <div class="kb-stat-bottom"></div>
                </div>

                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">🌱</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@cropCount</div>
                    <div class="kb-stat-label">Crop Records</div>
                    <div class="kb-stat-bottom"></div>
                </div>

                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">🌾</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@cultivationCount</div>
                    <div class="kb-stat-label">Cultivation Records</div>
                    <div class="kb-stat-bottom"></div>
                </div>

                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">🧪</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@soilTestCount</div>
                    <div class="kb-stat-label">Soil Tests</div>
                    <div class="kb-stat-bottom"></div>
                </div>

                <div class="kb-stat">
                    <div class="kb-stat-top">
                        <div class="kb-stat-icon">🔬</div>
                        <div class="kb-stat-arrow">↗</div>
                    </div>
                    <div class="kb-stat-number">@diseaseCount</div>
                    <div class="kb-stat-label">Disease Records</div>
                    <div class="kb-stat-bottom"></div>
                </div>
            </div>
        </section>

        <!-- AGRICULTURAL ANALYTICS -->
        <section class="kb-section">
            <div class="kb-section-heading">
                <div>
                    <h2 class="kb-section-title">Agricultural Analytics</h2>
                    <p class="kb-section-description">
                        Statistics based on current agricultural records
                    </p>
                </div>
            </div>

            <div class="kb-analytics-grid">
                <div class="kb-chart-card">
                    <div class="kb-chart-header">
                        <div>
                            <h3 class="kb-chart-title">Crop Cultivation Statistics</h3>
                            <p class="kb-chart-subtitle">
                                Cultivation records grouped by crop
                            </p>
                        </div>
                        <div class="kb-chart-badge">CROPS</div>
                    </div>

                    @if (cropStatistics.Any())
                    {
                        foreach (var crop in cropStatistics)
                        {
                            var cropWidth = crop.Count * 100.0 / maxCropCount;

                            <div class="kb-chart-row">
                                <div class="kb-chart-label-row">
                                    <span class="kb-chart-label">@crop.CropName</span>
                                    <span class="kb-chart-value">@crop.Count</span>
                                </div>

                                <div class="kb-chart-track">
                                    <div class="kb-chart-bar"
                                         style="width: @(cropWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="kb-empty-chart">
                            No cultivation statistics available yet.
                        </div>
                    }
                </div>

                <div class="kb-chart-card">
                    <div class="kb-chart-header">
                        <div>
                            <h3 class="kb-chart-title">Disease Statistics</h3>
                            <p class="kb-chart-subtitle">
                                Recorded diseases across crops
                            </p>
                        </div>
                        <div class="kb-chart-badge">DISEASES</div>
                    </div>

                    @if (diseaseStatistics.Any())
                    {
                        foreach (var disease in diseaseStatistics)
                        {
                            var diseaseWidth = disease.Count * 100.0 / maxDiseaseCount;

                            <div class="kb-chart-row">
                                <div class="kb-chart-label-row">
                                    <span class="kb-chart-label">@disease.DiseaseName</span>
                                    <span class="kb-chart-value">@disease.Count</span>
                                </div>

                                <div class="kb-chart-track">
                                    <div class="kb-chart-bar kb-chart-bar-disease"
                                         style="width: @(diseaseWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="kb-empty-chart">
                            No disease statistics available yet.
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- FARM PERFORMANCE -->
        <section class="kb-section">
            <div class="kb-section-heading">
                <div>
                    <h2 class="kb-section-title">🌾 Farm Performance Snapshot</h2>
                    <p class="kb-section-description">
                        Overview of current agricultural activities
                    </p>
                </div>
            </div>

            <div class="kb-performance-card">
                <div class="kb-performance-grid">
                    <div class="kb-performance-item">
                        <div class="kb-performance-icon">🚜</div>
                        <div>
                            <div class="kb-performance-label">Total Farms</div>
                            <div class="kb-performance-value">@farmCount</div>
                        </div>
                    </div>

                    <div class="kb-performance-item">
                        <div class="kb-performance-icon">🌱</div>
                        <div>
                            <div class="kb-performance-label">Total Crops</div>
                            <div class="kb-performance-value">@cropCount</div>
                        </div>
                    </div>

                    <div class="kb-performance-item">
                        <div class="kb-performance-icon">🌾</div>
                        <div>
                            <div class="kb-performance-label">Cultivation Records</div>
                            <div class="kb-performance-value">@cultivationCount</div>
                        </div>
                    </div>

                    <div class="kb-performance-item">
                        <div class="kb-performance-icon">🧪</div>
                        <div>
                            <div class="kb-performance-label">Soil Tests</div>
                            <div class="kb-performance-value">@soilTestCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- HARVEST REMINDERS -->
        <section class="kb-section">
            <div class="kb-section-heading">
                <div>
                    <h2 class="kb-section-title">🌾 Harvest Reminders</h2>
                    <p class="kb-section-description">
                        Upcoming harvests within the next 7 days
                    </p>
                </div>
            </div>

            @if (upcomingHarvests.Any())
            {
                <div class="kb-harvest-card">
                    @foreach (var cultivation in upcomingHarvests)
                    {
                        var daysLeft =
                            (cultivation.HarvestDate.Value.Date - DateTime.Now.Date).Days;

                        <div class="kb-harvest-item">
                            <div>
                                <div class="kb-harvest-date">
                                    🌱 Harvest Date:
                                    @cultivation.HarvestDate.Value.ToString("dd MMM yyyy")
                                </div>

                                <div class="kb-harvest-id">
                                    Cultivation ID: @cultivation.CultivationId
                                </div>
                            </div>

                            <div class="kb-harvest-badge">
                                @if (daysLeft == 0)
                                {
                                    <span>Harvest Today</span>
                                }
                                else if (daysLeft == 1)
                                {
                                    <span>Tomorrow</span>
                                }
                                else
                                {
                                    <span>In @daysLeft days</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="kb-harvest-card">
                    <div class="kb-harvest-empty">
                        🌱 No upcoming harvests within the next 7 days.
                    </div>
                </div>
            }
        </section>

        <!-- AGRICULTURAL MANAGEMENT -->
        <section class="kb-section">
            <div class="kb-section-heading">
                <div>
                    <h2 class="kb-section-title">Agricultural Management</h2>
                    <p class="kb-section-description">
                        Manage the core records of the agricultural database
                    </p>
                </div>
            </div>

            <div class="kb-module-grid">
                <a asp-controller="Farmers" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">👨‍🌾</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Farmers</h3>
                    <p>Manage farmer profiles and contact information.</p>
                </a>

                <a asp-controller="Farms" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🚜</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Farms</h3>
                    <p>Maintain farm records and their associated farmers.</p>
                </a>

                <a asp-controller="Crops" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🌾</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Crops</h3>
                    <p>Organize crop information in the system.</p>
                </a>

                <a asp-controller="Cultivations" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🌱</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Cultivation</h3>
                    <p>Maintain crop cultivation records for each farm.</p>
                </a>

                <a asp-controller="SoilTests" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🧪</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Soil Tests</h3>
                    <p>Store soil testing information for agricultural farms.</p>
                </a>

                <a asp-controller="Diseases" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🔬</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>Diseases</h3>
                    <p>Maintain crop disease information and records.</p>
                </a>

                <a asp-controller="AIAssistant" asp-action="Index" class="kb-module">
                    <div class="kb-module-top">
                        <div class="kb-module-icon">🤖</div>
                        <div class="kb-module-arrow">→</div>
                    </div>
                    <h3>AI Agricultural Assistant</h3>
                    <p>Get agricultural guidance about crops, soil and cultivation.</p>
                </a>
            </div>
        </section>

        <!-- ACCOUNT & ACCESS -->
        <div class="kb-system-info">
            <div class="kb-system-left">
                <div class="kb-system-icon">🔐</div>
                <div>
                    <div class="kb-system-title">Account & Access</div>
                    <div class="kb-system-text">
                        @if (role == "Admin")
                        {
                            <span>Admin access enabled — record management is available.</span>
                        }
                        else
                        {
                            <span>User access enabled — available records can be viewed.</span>
                        }
                    </div>
                </div>
            </div>

            <div class="kb-role">@role Account</div>
        </div>

    </div>
</div>
