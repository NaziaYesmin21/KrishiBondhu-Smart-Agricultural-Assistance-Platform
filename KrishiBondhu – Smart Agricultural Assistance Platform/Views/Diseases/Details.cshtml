@model Disease

@{
ViewData["Title"] = "Disease Details";
}

<div class="container py-5">

<div class="mb-4">

    <small class="text-success fw-bold">
        CROP HEALTH MANAGEMENT
    </small>

    <h2 class="fw-bold mt-1" style="color:#174A32;">
        <i class="bi bi-info-circle me-2"></i>
        Disease Details
    </h2>

    <p class="text-muted">
        View detailed information about the selected crop disease.
    </p>

</div>


<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header text-white p-4"
         style="background:linear-gradient(135deg,#174A32,#2E7D32);">

        <h4 class="mb-1">
            Disease Information
        </h4>

        <small>
            Complete disease record
        </small>

    </div>


    <div class="card-body p-4">

        <div class="row g-4">


            <div class="col-md-6">

                <div class="p-4 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Crop
                    </small>

                    <h5 class="mt-2 mb-0 fw-semibold"
                        style="color:#174A32;">

                        @(Model.Crop?.CropName ?? "N/A")

                    </h5>

                </div>

            </div>


            <div class="col-md-6">

                <div class="p-4 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Disease Name
                    </small>

                    <h5 class="mt-2 mb-0 fw-semibold"
                        style="color:#174A32;">

                        @Model.DiseaseName

                    </h5>

                </div>

            </div>


            <div class="col-12">

                <div class="p-4 rounded-3"
                     style="background:#f5f9f6;">

                    <div class="d-flex align-items-center mb-2">

                        <i class="bi bi-exclamation-circle me-2"
                           style="color:#174A32;">
                        </i>

                        <strong style="color:#294638;">
                            Symptoms
                        </strong>

                    </div>

                    <p class="mb-0 text-muted">
                        @Model.Symptoms
                    </p>

                </div>

            </div>


            <div class="col-12">

                <div class="p-4 rounded-3"
                     style="background:#f5f9f6;">

                    <div class="d-flex align-items-center mb-2">

                        <i class="bi bi-shield-check me-2"
                           style="color:#174A32;">
                        </i>

                        <strong style="color:#294638;">
                            Treatment
                        </strong>

                    </div>

                    <p class="mb-0 text-muted">
                        @Model.Treatment
                    </p>

                </div>

            </div>


        </div>


        <div class="border-top mt-4 pt-4">

            <a asp-action="Index"
               class="btn btn-success px-4">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Diseases

            </a>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.DiseaseId"
                   class="btn btn-outline-primary px-4 ms-2">

                    <i class="bi bi-pencil me-1"></i>
                    Edit

                </a>
            }

        </div>

    </div>

</div>

</div>