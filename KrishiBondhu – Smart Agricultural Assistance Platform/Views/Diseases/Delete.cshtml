@model Disease

@{
ViewData["Title"] = "Delete Disease";
}

<div class="container py-5">

<div class="mb-4">
    <small class="text-danger fw-bold">
        CROP HEALTH MANAGEMENT
    </small>

    <h2 class="fw-bold mt-1" style="color:#174A32;">
        <i class="bi bi-trash3 me-2"></i>
        Delete Disease
    </h2>

    <p class="text-muted">
        Review the information below before deleting this disease record.
    </p>
</div>

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header text-white p-4"
         style="background:linear-gradient(135deg,#174A32,#2E7D32);">

        <h4 class="mb-1">
            Disease Information
        </h4>

        <small>
            This action cannot be undone.
        </small>

    </div>

    <div class="card-body p-4">

        <div class="alert alert-warning rounded-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Are you sure you want to delete this disease record?
        </div>

        <div class="row g-4">

            <div class="col-md-6">

                <div class="p-3 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Crop
                    </small>

                    <h5 class="mt-1 mb-0">
                        @(Model.Crop?.CropName ?? "N/A")
                    </h5>

                </div>

            </div>

            <div class="col-md-6">

                <div class="p-3 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Disease Name
                    </small>

                    <h5 class="mt-1 mb-0">
                        @Model.DiseaseName
                    </h5>

                </div>

            </div>

            <div class="col-12">

                <div class="p-3 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Symptoms
                    </small>

                    <p class="mt-2 mb-0">
                        @Model.Symptoms
                    </p>

                </div>

            </div>

            <div class="col-12">

                <div class="p-3 rounded-3"
                     style="background:#f5f9f6;">

                    <small class="text-muted">
                        Treatment
                    </small>

                    <p class="mt-2 mb-0">
                        @Model.Treatment
                    </p>

                </div>

            </div>

        </div>

        <div class="border-top mt-4 pt-4">

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="DiseaseId" />

                <button type="submit"
                        class="btn btn-danger px-4">

                    <i class="bi bi-trash3 me-1"></i>
                    Delete Disease

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4 ms-2">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

</div>