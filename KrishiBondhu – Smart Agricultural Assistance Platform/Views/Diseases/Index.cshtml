@model IEnumerable<Disease>

@{
ViewData["Title"] = "Diseases";
var role = Context.Session.GetString("Role");
}

<div class="container py-5">
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <small class="text-success fw-bold">CROP HEALTH MANAGEMENT</small>

        <h2 class="fw-bold mt-1" style="color:#174A32;">
            <i class="bi bi-heart-pulse me-2"></i>
            Crop Diseases
        </h2>

        <p class="text-muted">
            Manage crop disease information, symptoms, and treatment.
        </p>
    </div>

    @if (role == "Admin")
    {
        <a asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-lg me-1"></i>
            Add Disease

        </a>
    }

</div>


<div class="card border-0 shadow-sm rounded-4">

    <div class="card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead style="background:#f1f7f2;">

                        <tr>

                            <th>ID</th>

                            <th>Crop</th>

                            <th>Disease</th>

                            <th>Symptoms</th>

                            <th>Treatment</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="badge bg-light text-success">
                                        #@item.DiseaseId
                                    </span>
                                </td>


                                <td>

                                    <strong>
                                        @(item.Crop?.CropName ?? "N/A")
                                    </strong>

                                </td>


                                <td>

                                    <strong>
                                        @item.DiseaseName
                                    </strong>

                                </td>


                                <td style="max-width:250px;">

                                    @item.Symptoms

                                </td>


                                <td style="max-width:250px;">

                                    @item.Treatment

                                </td>


                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.DiseaseId"
                                           class="btn btn-sm btn-outline-success">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        @if (role == "Admin")
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.DiseaseId"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-id="@item.DiseaseId"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center p-5">

                <i class="bi bi-heart-pulse"
                   style="font-size:50px;color:#174A32;">
                </i>

                <h4 class="mt-3">
                    No Disease Records
                </h4>

                <p class="text-muted">
                    No crop disease records are available.
                </p>

                @if (role == "Admin")
                {
                    <a asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add First Disease

                    </a>
                }

            </div>
        }

    </div>

</div>
</div>