@model IEnumerable<Farmer>

@{
    ViewData["Title"] = "Farmers";
}

<style>
    .kb-page {
        min-height: calc(100vh - 70px);
        background: #f3f6f2;
        padding: 32px 0 55px;
    }

    .kb-container {
        max-width: 1250px;
        margin: auto;
        padding: 0 22px;
    }

    .kb-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .kb-title-area h1 {
        margin: 0;
        color: #18352a;
        font-size: 32px;
        font-weight: 750;
    }

    .kb-title-area p {
        margin: 7px 0 0;
        color: #7a857f;
        font-size: 14px;
    }

    .kb-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #176b45;
        color: white;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 650;
        transition: 0.2s;
    }

        .kb-add-btn:hover {
            background: #125637;
            color: white;
            transform: translateY(-2px);
        }

    .kb-summary {
        background: white;
        border: 1px solid #e3e9e4;
        border-radius: 17px;
        padding: 20px 23px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .kb-summary-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        background: #eaf5ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .kb-summary-number {
        color: #183d2c;
        font-size: 22px;
        font-weight: 750;
    }

    .kb-summary-text {
        color: #7c8680;
        font-size: 13px;
    }

    .kb-table-card {
        background: white;
        border: 1px solid #e3e9e4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(30,60,45,0.05);
    }

    .kb-table-top {
        padding: 19px 23px;
        border-bottom: 1px solid #edf0ed;
    }

    .kb-table-title {
        color: #234435;
        font-size: 16px;
        font-weight: 700;
    }

    .kb-table-subtitle {
        color: #89928d;
        font-size: 12px;
        margin-top: 3px;
    }

    .kb-table-wrapper {
        overflow-x: auto;
    }

    .kb-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

        .kb-table thead {
            background: #f5f8f5;
        }

        .kb-table th {
            padding: 15px 18px;
            text-align: left;
            color: #5e6c64;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #e7ece8;
        }

        .kb-table td {
            padding: 16px 18px;
            color: #4f5e55;
            font-size: 13px;
            border-bottom: 1px solid #eef1ef;
            vertical-align: middle;
        }

        .kb-table tbody tr:hover {
            background: #f8fbf9;
        }

        .kb-table tbody tr:last-child td {
            border-bottom: none;
        }

    .kb-farmer {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .kb-avatar {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #e9f5ed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .kb-farmer-name {
        color: #244536;
        font-weight: 650;
    }

    .kb-actions {
        display: flex;
        gap: 6px;
        white-space: nowrap;
    }

    .kb-action {
        text-decoration: none;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 650;
    }

    .kb-edit {
        background: #eef6f1;
        color: #176b45;
    }

        .kb-edit:hover {
            background: #dceee3;
            color: #125637;
        }

    .kb-details {
        background: #f0f3f5;
        color: #53616a;
    }

        .kb-details:hover {
            background: #e2e7ea;
            color: #39454d;
        }

    .kb-delete {
        background: #fff1f0;
        color: #c2413b;
    }

        .kb-delete:hover {
            background: #ffe1df;
            color: #a52f2a;
        }

    .kb-empty {
        text-align: center;
        padding: 65px 25px;
    }

    .kb-empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 17px;
        border-radius: 18px;
        background: #edf6f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .kb-empty h3 {
        margin: 0 0 7px;
        color: #274738;
        font-size: 19px;
    }

    .kb-empty p {
        margin: 0 auto 20px;
        max-width: 430px;
        color: #7e8882;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 700px) {
        .kb-page {
            padding-top: 22px;
        }

        .kb-container {
            padding: 0 14px;
        }

        .kb-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .kb-title-area h1 {
            font-size: 27px;
        }

        .kb-add-btn {
            width: 100%;
            justify-content: center;
        }

        .kb-summary {
            padding: 17px;
        }
    }
</style>


<div class="kb-page">

    <div class="kb-container">

        <!-- PAGE HEADER -->

        <div class="kb-page-header">

            <div class="kb-title-area">
                <h1>Farmers</h1>

                <p>
                    Manage registered farmers and their contact information.
                </p>
            </div>

            <a asp-action="Create" class="kb-add-btn">
                <span>＋</span>
                Add New Farmer
            </a>

        </div>


        <!-- SUMMARY -->

        <div class="kb-summary">

            <div class="kb-summary-icon">
                👨‍🌾
            </div>

            <div>
                <div class="kb-summary-number">
                    @Model.Count()
                </div>

                <div class="kb-summary-text">
                    Registered farmers in the system
                </div>
            </div>

        </div>


        <!-- TABLE -->

        <div class="kb-table-card">

            <div class="kb-table-top">

                <div class="kb-table-title">
                    Farmer Directory
                </div>

                <div class="kb-table-subtitle">
                    Available farmer records
                </div>

            </div>


            @if (Model.Any())
            {
                <div class="kb-table-wrapper">

                    <table class="kb-table">

                        <thead>
                            <tr>
                                <th>Farmer</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="kb-farmer">

                                            <div class="kb-avatar">
                                                👨‍🌾
                                            </div>

                                            <div class="kb-farmer-name">
                                                @item.Name
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @item.Phone
                                    </td>

                                    <td>
                                        @item.Address
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>

                                        <div class="kb-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.FarmerId"
                                               class="kb-action kb-edit">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.FarmerId"
                                               class="kb-action kb-details">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.FarmerId"
                                               class="kb-action kb-delete">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="kb-empty">

                    <div class="kb-empty-icon">
                        👨‍🌾
                    </div>

                    <h3>No farmers registered yet</h3>

                    <p>
                        There are currently no farmer records in the database.
                        Add your first farmer to start managing agricultural information.
                    </p>

                    <a asp-action="Create" class="kb-add-btn">
                        ＋ Add First Farmer
                    </a>

                </div>
            }

        </div>

    </div>

</div>