@model IEnumerable<Farmer>

@{
    ViewData["Title"] = "Farmers";
}


<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message">
        ✓ @TempData["SuccessMessage"]
    </div>
}


<div class="farmers-page">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <h1>Farmer Management</h1>
            <p>Search, filter and manage registered farmers.</p>
        </div>

        @if (Context.Session.GetString("Role") == "Admin")
        {
            <div class="header-actions">

                <a asp-action="ExportExcel" class="btn-export">
                    📊 Export Excel
                </a>

                <a asp-action="Create" class="btn-add">
                    + Add Farmer
                </a>

            </div>
        }

    </div>


    <!-- Search & Filter Section -->
    <div class="search-filter-card">

        <form asp-action="Index" method="get">

            <div class="form-row">

                <!-- Search -->
                <div class="form-group">

                    <label>Search Farmer</label>

                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search by name or phone..." />

                </div>


                <!-- Address Filter -->
                <div class="form-group">

                    <label>Filter by Address</label>

                    <input type="text"
                           name="address"
                           value="@ViewBag.Address"
                           class="form-control"
                           placeholder="Enter address..." />

                </div>


                <!-- Buttons -->
                <div class="button-group">

                    <button type="submit" class="btn-search">
                        Search / Filter
                    </button>

                    <a asp-action="Index" class="btn-clear">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Result Information -->
    <div class="result-info">

        <div>
            <strong>@ViewBag.TotalFarmers</strong> farmer(s) found
        </div>

        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
        {
            <span class="filter-tag">
                Search: "@ViewBag.SearchTerm"
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(ViewBag.Address as string))
        {
            <span class="filter-tag">
                Address: "@ViewBag.Address"
            </span>
        }

    </div>


    <!-- Farmers Table -->
    @if (Model.Any())
    {
        <div class="table-card">

            <div class="table-responsive">

                <table class="farmers-table">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var farmer in Model)
                        {
                            <tr>

                                <td>
                                    @farmer.FarmerId
                                </td>

                                <td>
                                    <strong>@farmer.Name</strong>
                                </td>

                                <td>
                                    @farmer.Phone
                                </td>

                                <td>
                                    @farmer.Address
                                </td>

                                <td>
                                    @farmer.Email
                                </td>

                                <td class="actions">

                                    @if (Context.Session.GetString("Role") == "Admin")
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@farmer.FarmerId"
                                           class="action-btn edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@farmer.FarmerId"
                                           class="action-btn delete">
                                            Delete
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@farmer.FarmerId"
                                       class="action-btn details">
                                        Details
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">

                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-address="@ViewBag.Address"
                       class="page-btn">
                        ← Previous
                    </a>
                }


                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="page-btn active">
                            @i
                        </span>
                    }
                    else
                    {
                        <a asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-address="@ViewBag.Address"
                           class="page-btn">
                            @i
                        </a>
                    }
                }


                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-address="@ViewBag.Address"
                       class="page-btn">
                        Next →
                    </a>
                }

            </div>
        }

    }
    else
    {
        <!-- No Results -->

        <div class="no-results">

            <div class="no-results-icon">
                🔎
            </div>

            <h3>No farmers found</h3>

            <p>
                No farmer matches your current search or filter.
            </p>

            <a asp-action="Index" class="btn-clear">
                Show All Farmers
            </a>

        </div>
    }

</div>


<style>

    /* Success Message */

    .success-message {
        max-width: 1200px;
        margin: 20px auto 0;
        padding: 14px 18px;
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        border-radius: 10px;
        font-weight: 600;
    }


    /* Main Page */

    .farmers-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }


    /* Header */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
        }

        .page-header p {
            margin-top: 6px;
            color: #6b7280;
        }


    /* Header Actions */

    .header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }


    /* Add Farmer Button */

    .btn-add {
        background: #198754;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #157347;
            color: white;
        }


    /* Export Excel Button */

    .btn-export {
        background: #198754;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-export:hover {
            background: #157347;
            color: white;
        }


    /* Search Filter Card */

    .search-filter-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .form-row {
        display: flex;
        gap: 15px;
        align-items: end;
    }

    .form-group {
        flex: 1;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #374151;
        }

    .form-control {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #198754;
        }


    /* Buttons */

    .button-group {
        display: flex;
        gap: 8px;
    }

    .btn-search,
    .btn-clear {
        padding: 11px 16px;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
        white-space: nowrap;
    }

    .btn-search {
        background: #198754;
        color: white;
    }

        .btn-search:hover {
            background: #157347;
        }

    .btn-clear {
        background: #e5e7eb;
        color: #374151;
    }

        .btn-clear:hover {
            background: #d1d5db;
            color: #111827;
        }


    /* Result Information */

    .result-info {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px;
        color: #6b7280;
    }

        .result-info strong {
            color: #198754;
        }

    .filter-tag {
        background: #e8f5ee;
        color: #198754;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
    }


    /* Table */

    .table-card {
        background: white;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .farmers-table {
        width: 100%;
        border-collapse: collapse;
    }

        .farmers-table th {
            background: #198754;
            color: white;
            padding: 14px;
            text-align: left;
            font-size: 14px;
        }

        .farmers-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
        }

        .farmers-table tr:hover {
            background: #f9fafb;
        }


    /* Action Buttons */

    .actions {
        white-space: nowrap;
    }

    .action-btn {
        display: inline-block;
        padding: 6px 9px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        margin-right: 4px;
    }

    .edit {
        background: #fff3cd;
        color: #856404;
    }

    .delete {
        background: #f8d7da;
        color: #842029;
    }

    .details {
        background: #dbeafe;
        color: #1e40af;
    }


    /* Pagination */

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 25px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .page-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 40px;
        height: 40px;
        padding: 0 12px;
        border-radius: 8px;
        background: white;
        color: #198754;
        border: 1px solid #d1d5db;
        text-decoration: none;
        font-weight: 600;
        box-sizing: border-box;
    }

        .page-btn:hover {
            background: #e8f5ee;
            color: #157347;
        }

        .page-btn.active {
            background: #198754;
            color: white;
            border-color: #198754;
        }


    /* No Results */

    .no-results {
        text-align: center;
        background: white;
        border-radius: 14px;
        padding: 60px 20px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .no-results-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .no-results h3 {
        margin-bottom: 8px;
    }

    .no-results p {
        color: #6b7280;
        margin-bottom: 20px;
    }


    /* Responsive Design */

    @@media (max-width: 768px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
            flex-wrap: wrap;
        }

        .form-row {
            flex-direction: column;
            align-items: stretch;
        }

        .button-group {
            width: 100%;
        }

        .btn-search,
        .btn-clear {
            flex: 1;
            text-align: center;
        }

        .farmers-page {
            padding: 20px 12px;
        }

        .page-header h1 {
            font-size: 26px;
        }
    }

</style>