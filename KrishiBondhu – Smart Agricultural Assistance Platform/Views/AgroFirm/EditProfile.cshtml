
@model KrishiBondhu___Smart_Agricultural_Assistance_Platform.Models.AgroFirm

@{
    ViewData["Title"] = "Edit Firm Profile";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-success mb-2">Edit Firm Profile</h2>
                    <p class="text-muted">
                        Update your agricultural business information.
                    </p>

                    <hr />

                    <form asp-controller="AgroFirm"
                          asp-action="EditProfile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="AgroFirmId" />

                        <div class="mb-3">
                            <label asp-for="FirmName" class="form-label">
                                Firm Name
                            </label>
                            <input asp-for="FirmName" class="form-control" />
                            <span asp-validation-for="FirmName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OwnerName" class="form-label">
                                Owner Name
                            </label>
                            <input asp-for="OwnerName" class="form-control" />
                            <span asp-validation-for="OwnerName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">
                                Phone Number
                            </label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email
                            </label>
                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">
                                Business Address
                            </label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="2"></textarea>
                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BusinessType" class="form-label">
                                Business Type
                            </label>
                            <select asp-for="BusinessType"
                                    class="form-select">
                                <option value="InputFirm">
                                    Agricultural Input Firm
                                </option>
                                <option value="ServiceFirm">
                                    Agricultural Service Firm
                                </option>
                            </select>
                            <span asp-validation-for="BusinessType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describe your products or services"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Save Changes
                        </button>

                        <a asp-controller="AgroFirm"
                           asp-action="Dashboard"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
