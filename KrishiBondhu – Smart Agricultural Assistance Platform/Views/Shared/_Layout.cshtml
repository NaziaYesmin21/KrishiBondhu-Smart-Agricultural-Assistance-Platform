
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KrishiBondhu</title>

    <script type="importmap"></script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KrishiBondhu___Smart_Agricultural_Assistance_Platform.styles.css"
          asp-append-version="true" />

    <style>
            /* GLOBAL */
            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                background: #edf5ef;
                color: #294638;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            /* NAVBAR */
            .kb-navbar {
                background: #123f2b;
                min-height: 78px;
                border: none;
                box-shadow: 0 4px 18px rgba(18, 63, 43, 0.15);
            }

            .kb-navbar-inner {
                max-width: 1500px;
                width: 100%;
                margin: auto;
                padding: 0 24px;
            }

            /* BRAND */
            .kb-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                color: white !important;
                text-decoration: none;
                font-size: 22px;
                font-weight: 750;
                letter-spacing: -0.4px;
                flex-shrink: 0;
            }

            .kb-brand-mark {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: #2d8a59;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
            }

            .kb-brand-text {
                line-height: 1.05;
            }

            .kb-brand-name {
                display: block;
            }

            .kb-brand-tagline {
                display: block;
                color: rgba(255,255,255,0.65);
                font-size: 8px;
                font-weight: 500;
                letter-spacing: 1px;
                text-transform: uppercase;
                margin-top: 5px;
            }

            /* NAVIGATION LINKS */
            .kb-nav {
                margin-left: 24px;
                gap: 4px;
            }

            .kb-nav-link {
                color: rgba(255,255,255,0.88) !important;
                text-decoration: none;
                font-size: 15px;
                font-weight: 650;
                padding: 11px 13px !important;
                border-radius: 9px;
                white-space: nowrap;
                transition: all 0.2s ease;
            }

                .kb-nav-link:hover,
                .kb-nav-link:focus {
                    color: white !important;
                    background: rgba(255,255,255,0.12);
                }

            /* ACCOUNT */
            .kb-account {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-left: auto;
                flex-shrink: 0;
            }

            .kb-account-info {
                display: flex;
                align-items: center;
                gap: 8px;
                padding-right: 5px;
            }

            .kb-account-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: #205b3f;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
            }

            .kb-account-name {
                color: white;
                font-size: 14px;
                font-weight: 650;
            }

            .kb-account-role {
                color: #9bc4ab;
                font-size: 11px;
                margin-top: 3px;
            }

            /* LOGOUT */
            .kb-logout {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                color: #d9eee0 !important;
                text-decoration: none;
                border: 1px solid rgba(255,255,255,0.2);
                background: rgba(255,255,255,0.06);
                padding: 9px 13px;
                border-radius: 8px;
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
                transition: all 0.2s ease;
            }

                .kb-logout:hover {
                    color: white !important;
                    background: rgba(255,255,255,0.15);
                }

            /* MOBILE MENU BUTTON */
            .kb-toggler {
                border: 1px solid rgba(255,255,255,0.3) !important;
                padding: 7px 10px;
            }

                .kb-toggler .navbar-toggler-icon {
                    filter: brightness(0) invert(1);
                }

                .kb-toggler:focus {
                    box-shadow: none;
                }

            /* MAIN BACKGROUND */
            .kb-main-wrapper {
                min-height: calc(100vh - 135px);
                background: radial-gradient( circle at 92% 8%, rgba(45, 138, 89, 0.08), transparent 26% ), radial-gradient( circle at 5% 85%, rgba(82, 145, 101, 0.05), transparent 30% ), #edf5ef;
                padding-top: 1px;
            }

            .kb-main-container {
                max-width: 1500px;
                margin: 0 auto;
                padding: 0 24px;
            }

            /* FOOTER */
            .kb-footer {
                background: #103824;
                border: none;
                color: rgba(255,255,255,0.65);
                padding: 18px 24px;
                font-size: 11px;
            }

            .kb-footer-inner {
                max-width: 1450px;
                margin: auto;
            }

            .kb-footer strong {
                color: rgba(255,255,255,0.9);
            }

            .kb-footer a {
                color: #a9d2b8;
                text-decoration: none;
            }

                .kb-footer a:hover {
                    color: white;
                }

            /* MEDIUM SCREENS */
            @@media (max-width: 1350px) {
                .kb-navbar-inner {
                    padding: 0 16px;
                }

                .kb-brand {
                    font-size: 20px;
                }

                .kb-nav {
                    margin-left: 12px;
                    gap: 2px;
                }

                .kb-nav-link {
                    font-size: 13px;
                    padding: 10px 8px !important;
                }

                .kb-account-info {
                    gap: 6px;
                }

                .kb-account-name {
                    font-size: 12px;
                }

                .kb-logout {
                    padding: 8px 10px;
                    font-size: 12px;
                }
            }

            /* TABLETS AND MOBILE */
            @@media (max-width: 991px) {
                .kb-navbar-inner {
                    padding: 12px 18px;
                    flex-wrap: wrap;
                }

                .kb-nav {
                    margin-left: 0;
                    padding-top: 12px;
                    padding-bottom: 8px;
                    gap: 4px;
                }

                .kb-nav-link {
                    display: block;
                    font-size: 15px;
                    padding: 11px 12px !important;
                }

                .kb-account {
                    margin: 8px 0 6px;
                    padding-top: 14px;
                    border-top: 1px solid rgba(255,255,255,0.15);
                    justify-content: space-between;
                    width: 100%;
                }

                .kb-main-container {
                    padding: 0 18px;
                }
            }

            /* SMALL MOBILE */
            @@media (max-width: 600px) {
                .kb-brand {
                    font-size: 18px;
                }

                .kb-brand-mark {
                    width: 36px;
                    height: 36px;
                    font-size: 19px;
                }

                .kb-brand-tagline {
                    font-size: 7px;
                    letter-spacing: 0.7px;
                }

                .kb-main-container {
                    padding: 0 12px;
                }

                .kb-footer {
                    padding: 16px 14px;
                }
            }
    </style>
</head>

<body>
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg kb-navbar">
            <div class="kb-navbar-inner d-flex align-items-center">

                <!-- BRAND -->
                <a class="kb-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="kb-brand-mark">🌱</span>

                    <span class="kb-brand-text">
                        <span class="kb-brand-name">KrishiBondhu</span>
                        <span class="kb-brand-tagline">
                            Smart Agricultural Assistance
                        </span>
                    </span>
                </a>

                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler kb-toggler ms-auto"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#kbNavigation"
                        aria-controls="kbNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAVIGATION -->
                <div class="collapse navbar-collapse" id="kbNavigation">
                    <ul class="navbar-nav kb-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                🏠 Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Farmers"
                               asp-action="Index">
                                👨‍🌾 Farmers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Farms"
                               asp-action="Index">
                                🌾 Farms
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Crops"
                               asp-action="Index">
                                🌱 Crops
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Cultivations"
                               asp-action="Index">
                                🚜 Cultivations
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="SoilTests"
                               asp-action="Index">
                                🧪 Soil Tests
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kb-nav-link"
                               asp-area=""
                               asp-controller="Diseases"
                               asp-action="Index">
                                🩺 Diseases
                            </a>
                        </li>

                    </ul>

                    <!-- ACCOUNT -->
                    @if (Context.Session.GetString("Username") != null)
                    {
                        <div class="kb-account">

                            <div class="kb-account-info">
                                <div class="kb-account-icon">👤</div>

                                <div>
                                    <div class="kb-account-name">
                                        @Context.Session.GetString("Username")
                                    </div>

                                    <div class="kb-account-role">
                                        @Context.Session.GetString("Role") Account
                                    </div>
                                </div>
                            </div>

                            <a class="kb-logout"
                               asp-controller="Auth"
                               asp-action="Logout">
                                ↪ Logout
                            </a>

                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="kb-main-wrapper">
        <main role="main" class="kb-main-container">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="kb-footer">
        <div class="kb-footer-inner">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>
                    © 2026
                    <strong>KrishiBondhu</strong>
                    — Smart Agricultural Assistance Platform
                </div>

                <div>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </div>

            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
